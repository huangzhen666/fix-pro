APP_ENV=local
HTTP_ADDR=:8080
DB_DSN=postgres://fixpro:fixpro-local@localhost:5433/fix_pro?sslmode=disable&timezone=UTC
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
MEDIA_DRIVER=local
MEDIA_LOCAL_ROOT=D:/work/fix-pro/.tmp/media-current
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=12345678
APP_ADMIN_BASIC_COMPAT=false
APP_ADMIN_COOKIE_SECURE=false
WORKER_DEV_TOKEN_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Customer phone login: server only; never place AppSecret in Mini Program code.
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
CUSTOMER_DEFAULT_ORG_ID=1
CUSTOMER_SESSION_TTL=168h
# Independent base64-encoded random 32-byte keys; preserve across restarts.
CUSTOMER_MOBILE_ENCRYPTION_KEY=
CUSTOMER_MOBILE_HASH_KEY=

# Diagnostic logging (production requires release metadata and instance ID)
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE=fix-pro-api
APP_VERSION=development
GIT_COMMIT=unknown
LOG_INSTANCE_ID=local
HTTP_SLOW_THRESHOLD=1s
MEDIA_SLOW_THRESHOLD=5s
DB_SLOW_THRESHOLD=200ms
UPSTREAM_SLOW_THRESHOLD=2s
JOB_SLOW_THRESHOLD=30s
LOG_MAX_EVENT_BYTES=16384
