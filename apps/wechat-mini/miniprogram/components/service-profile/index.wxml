<view wx:if="{{view}}" class="profile">
 <view wx:if="{{view.h.tags.length}}" class="tags"><text wx:for="{{view.h.tags}}" wx:key="*this">{{item}}</text></view>
 <view class="section"><view class="heading">本服务包含</view><view class="service-item" wx:for="{{view.items}}" wx:key="viewKey"><image wx:if="{{item.imageUrl}}" class="item-photo" src="{{item.imageUrl}}" mode="aspectFill" data-path="view.items[{{index}}].imageUrl" binderror="imageError"/><view wx:else class="icon"><image src="{{item.iconUrl}}"/></view><view class="item-copy"><view class="item-title">{{item.title}}</view><view class="copy">{{item.description}}</view></view></view></view>
 <view class="section notice"><view class="heading">费用与服务边界</view><view class="copy">{{view.serviceTarget}}</view><view class="copy">{{view.billing.unitDefinition}}</view><view class="copy">{{view.billing.quantityExplanation}}</view><view class="copy">{{view.billing.feeDescription}}</view><view wx:for="{{view.exclusions}}" wx:key="viewKey" class="boundary"><view class="item-title">不包含 · {{item.title}}</view><view class="copy">{{item.description}}</view></view><view wx:for="{{view.unsuitableConditions}}" wx:key="*this" class="copy">不适用：{{item}}</view><view wx:for="{{view.purchaseNotices}}" wx:key="*this" class="copy">{{item}}</view></view>
 <view wx:if="{{view.h.facts.length}}" class="section"><view class="heading">服务参数</view><view class="facts"><view wx:for="{{view.h.facts}}" wx:key="viewKey"><view class="muted">{{item.label}}</view><view>{{item.value}}</view></view></view></view>
 <view wx:if="{{view.h.resources.length}}" class="section"><view class="heading">工具与材料</view><view wx:for="{{view.h.resources}}" wx:key="viewKey" class="boundary"><view class="item-title">{{item.name}} · {{item.providerText}}</view><view class="copy">{{item.description}}</view></view></view>
 <view wx:if="{{view.h.preparations.length}}" class="section"><view class="heading">服务前准备</view><view class="check" wx:for="{{view.h.preparations}}" wx:key="*this"><text>✓</text><view>{{item}}</view></view></view>
 <view wx:if="{{view.h.steps.length}}" class="section"><view class="heading">服务流程</view><view wx:for="{{view.h.steps}}" wx:key="viewKey" class="step"><text class="step-number">{{index+1}}</text><view><view class="item-title">{{item.title}}</view><view class="copy">{{item.description}}</view></view></view></view>
 <view wx:if="{{view.h.gallery.length}}" class="section"><view class="heading">服务案例</view><view wx:for="{{view.h.gallery}}" wx:key="viewKey"><image class="case-photo" src="{{item.url}}" mode="aspectFill" data-src="{{item.url}}" bindtap="preview" data-path="view.h.gallery[{{index}}].url" binderror="imageError"/><view class="copy">{{item.caption}}</view></view></view>
 <view wx:if="{{view.h.comparisons.length}}" class="section"><view class="heading">前后对照</view><view wx:for="{{view.h.comparisons}}" wx:key="viewKey"><view class="item-title">{{item.title}}</view><view class="comparison"><view><image src="{{item.beforeUrl}}" mode="aspectFill" data-path="view.h.comparisons[{{index}}].beforeUrl" binderror="imageError"/><text>服务前</text></view><view><image src="{{item.afterUrl}}" mode="aspectFill" data-path="view.h.comparisons[{{index}}].afterUrl" binderror="imageError"/><text>服务后</text></view></view><view class="copy">{{item.description}}</view><view class="muted">{{item.effectNotice}}</view></view></view>
 <view class="section"><view class="heading">交付检查</view><view class="check" wx:for="{{view.acceptanceCriteria}}" wx:key="*this"><text>✓</text><view>{{item}}</view></view></view>
 <view class="section policy"><view class="heading">{{view.policyTitle}}</view><view class="item-title">{{view.afterSales.summary}}</view><view wx:if="{{view.periodText}}" class="period">{{view.periodText}}</view><view class="copy">{{view.afterSales.coverage}}</view><view class="copy" wx:for="{{view.afterSales.exclusions}}" wx:key="*this">不包含：{{item}}</view><view class="copy">{{view.afterSales.contactDescription}}</view></view>
 <view wx:if="{{view.h.faqs.length}}" class="section"><view class="heading">常见问题</view><view wx:for="{{view.h.faqs}}" wx:key="viewKey" class="boundary"><view class="item-title" data-index="{{index}}" bindtap="toggleFaq">{{item.question}} {{openFaq===index ? '−' : '+'}}</view><view wx:if="{{openFaq===index}}" class="copy">{{item.answer}}</view></view></view>
</view>
