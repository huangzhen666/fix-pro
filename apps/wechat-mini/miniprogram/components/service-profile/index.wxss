:host{display:block}.profile{font-size:15px;line-height:1.65;color:#1f2937}.section{background:#fff;border-radius:14px;padding:18px;margin:12px 0}.heading{font-size:18px;font-weight:600;margin-bottom:14px}.service-item{display:flex;gap:12px;align-items:flex-start;padding:13px 0;border-bottom:1px solid #edf1f5}.service-item:last-child{border:0}.icon{width:40px;height:40px;border-radius:12px;background:#edf3f8;display:flex;align-items:center;justify-content:center;flex-shrink:0}.icon image{width:23px;height:23px}.item-photo{width:66px;height:66px;border-radius:10px;flex-shrink:0}.item-copy{flex:1;min-width:0}.item-title{font-size:16px;font-weight:500;overflow-wrap:anywhere}.copy{color:#5f6f84;margin-top:6px;white-space:pre-wrap;overflow-wrap:anywhere}.notice{background:#fff6ed}.policy{background:#edf3f8}.boundary{margin-top:14px}.tags{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.tags text{padding:4px 10px;background:#edf3f8;color:#204f76;border-radius:6px;font-size:14px}.facts{display:grid;grid-template-columns:1fr 1fr;gap:16px}.muted{font-size:14px;color:#5f6f84;overflow-wrap:anywhere}.check{display:flex;gap:10px;margin-top:10px}.check text{color:#204f76}.check view{flex:1;min-width:0}.step{display:flex;gap:12px;margin:16px 0}.step-number{background:#204f76;color:#fff;width:28px;height:28px;line-height:28px;text-align:center;border-radius:50%;flex-shrink:0}.step>view{min-width:0;flex:1}.case-photo{width:100%;height:200px;border-radius:10px;margin-top:10px;background:#edf3f8}.comparison{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.comparison image{width:100%;height:140px;border-radius:10px}.comparison text{display:block;font-size:14px;color:#5f6f84;text-align:center}.period{display:inline-block;background:white;padding:5px 10px;border-radius:8px;margin-top:10px}
