:host{display:block}.overlay{position:fixed;inset:0;z-index:110;color:var(--color-text)}.mask{position:absolute;inset:0;background:rgba(15,23,42,.4)}.sheet{position:absolute;left:0;right:0;bottom:0;max-height:78vh;border-radius:18px 18px 0 0;background:var(--color-surface);display:flex;flex-direction:column;padding-top:12px}.heading{display:flex;align-items:center;justify-content:space-between;padding:0 16px;font-size:17px;font-weight:600}.heading button{margin:0;padding:0;width:36px;height:36px;line-height:36px;font-size:24px;color:var(--color-text-secondary);background:transparent}.heading button::after,.upload::after,.remove::after{border:0}.hint{font-size:12px;line-height:1.6;color:var(--color-text-secondary);padding:4px 16px 12px}.body{height:40vh;min-height:140px;max-height:48vh}.item{padding:12px 16px;border-top:1px solid var(--color-border)}.name{font-size:14px;margin-bottom:10px;font-weight:500;word-break:break-all}textarea{box-sizing:border-box;width:100%;height:72px;padding:10px 12px;font-size:13px;line-height:1.6;border-radius:8px;background:var(--color-page)}.count{text-align:right;margin:4px 0 10px;font-size:11px;color:var(--color-text-secondary)}.media-list{display:flex;gap:10px;flex-wrap:wrap}.media,.upload{width:60px;height:60px;border-radius:8px;background:var(--color-page);position:relative;display:flex;align-items:center;justify-content:center;flex:none;font-size:12px;color:var(--color-text-secondary)}.media image{width:100%;height:100%;border-radius:8px}.remove{position:absolute;right:-5px;top:-5px;width:22px;height:22px;line-height:22px;padding:0;margin:0;font-size:16px;color:#fff;background:var(--color-text-secondary);border-radius:50%}.upload{margin:0;padding:0;flex-direction:column;font-size:22px;line-height:1.3;border:1px dashed var(--color-border);box-sizing:border-box}.upload text{font-size:10px}.footer{padding:12px 16px calc(12px + env(safe-area-inset-bottom));border-top:1px solid var(--color-border)}.footer button{height:44px;line-height:44px;margin:0;padding:0;background:var(--color-primary);color:var(--color-on-primary);font-size:14px;border-radius:22px}.footer button[disabled]{background:var(--color-primary-disabled);color:var(--color-disabled-text)}.error{padding:8px 16px;color:var(--color-danger);font-size:12px;line-height:1.6}.retry{display:flex;gap:12px}.retry button,.hint button{padding:0 10px;margin:8px 0;height:32px;line-height:32px;font-size:12px;color:var(--color-primary);background:var(--color-primary-soft)}

.previous{margin:8px 16px;padding:12px;font-size:12px;line-height:1.7;background:var(--color-page);border-radius:8px;white-space:pre-wrap;word-break:break-word}.previous>view{margin-bottom:8px}.previous button{font-size:12px;color:var(--color-primary)}
