<view class="search-page"><view class="search-row"><view class="search-box">⌕<input value="{{keyword}}" bindinput="input" confirm-type="search" bindconfirm="search" placeholder="搜索维修服务"/></view><button loading="{{loading}}" bindtap="search">搜索</button></view><view wx:if="{{!searched}}"><view class="section-title">常用搜索</view><view class="suggestions"><view wx:for="{{suggestions}}" wx:key="*this" data-value="{{item}}" bindtap="choose">{{item}}</view></view><view class="tip-card"><view class="tip-title">从真实服务目录搜索</view><view class="muted">结果只展示后台已发布 SKU，不会出现前端硬编码的虚假服务。</view></view></view><view wx:else><view class="result-count">找到 {{results.length}} 项服务</view><view class="result" wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image src="{{item.coverImageUrl}}" mode="aspectFill"/><view class="result-main"><view class="result-name">{{item.name}}</view><view class="muted ellipsis">{{item.description}}</view><view class="price">¥{{item.priceText}}<text>/{{item.unit}}</text></view></view></view><view wx:if="{{!results.length}}" class="empty">没有找到对应服务，请更换关键词或联系客服</view></view></view>
