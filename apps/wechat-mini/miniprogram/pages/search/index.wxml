<view class="search-page">
  <view class="search-row"><view class="search-box"><image src="/assets/icons/search.svg" mode="aspectFit"/><input value="{{keyword}}" bindinput="input" confirm-type="search" bindconfirm="search" placeholder="搜索维修服务" placeholder-class="search-placeholder"/></view><button loading="{{loading}}" disabled="{{loading}}" bindtap="search">搜索</button></view>
  <view wx:if="{{!searched}}"><view class="section-title">常用搜索</view><view class="suggestions"><view wx:for="{{suggestions}}" wx:key="*this" data-value="{{item}}" bindtap="choose">{{item}}</view></view></view>
  <view wx:else><view class="result-count">找到 {{results.length}} 项服务</view><view class="result" wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image src="{{item.coverImageUrl}}" mode="aspectFill"/><view class="result-main"><view class="result-name">{{item.name}}</view><view wx:if="{{item.description}}" class="muted ellipsis">{{item.description}}</view><view class="price">¥{{item.priceText}}<text>/{{item.unit}}</text></view></view><image class="result-arrow" src="/assets/icons/chevron-right.svg" mode="aspectFit"/></view><view wx:if="{{!results.length}}" class="empty">没有找到对应服务，试试其他关键词吧</view></view>
</view>
