.search-page{padding:28rpx}.search-row{display:flex;gap:16rpx}.search-box{flex:1;height:78rpx;border:2rpx solid #1677ff;border-radius:40rpx;background:#fff;display:flex;align-items:center;padding:0 24rpx;font-size:38rpx}.search-box input{flex:1;margin-left:12rpx;font-size:26rpx}.search-row button{width:140rpx;height:78rpx;line-height:78rpx;border-radius:40rpx;background:#1677ff;color:#fff;margin:0;padding:0}.section-title{margin-top:50rpx}.suggestions{display:flex;flex-wrap:wrap;gap:16rpx}.suggestions view{padding:14rpx 26rpx;background:#eef5ff;color:#356aa8;border-radius:30rpx}.tip-card{margin-top:40rpx;padding:30rpx;border-radius:20rpx;background:linear-gradient(140deg,#f1f6ff,#fff)}.tip-title{font-size:30rpx;font-weight:700;margin-bottom:10rpx}.result-count{color:#667085;margin:30rpx 0}.result{display:flex;gap:20rpx;background:#fff;border-radius:20rpx;padding:18rpx;margin-bottom:18rpx}.result image{width:180rpx;height:150rpx;border-radius:14rpx;background:#eef2f6}.result-main{flex:1;min-width:0}.result-name{font-size:30rpx;font-weight:700}.ellipsis{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.price{color:#e5484d;font-size:32rpx;font-weight:800;margin-top:8rpx}.price text{font-size:20rpx;color:#667085;font-weight:400}.empty{text-align:center;color:#667085;padding:160rpx 30rpx}
