.home{padding-bottom:40rpx}.hero{padding:54rpx 30rpx 46rpx;background:linear-gradient(145deg,#dcebff 0%,#f4f8ff 60%,#fff 100%)}.brand{font-size:30rpx;font-weight:700;color:#1854a3}.slogan{font-size:44rpx;font-weight:800;margin:12rpx 0 32rpx}.search{height:88rpx;background:#fff;border-radius:44rpx;display:flex;align-items:center;padding:0 28rpx;color:#98a2b3;box-shadow:0 10rpx 32rpx rgba(31,100,190,.1)}.search-icon{font-size:48rpx;color:#1f2937;margin-right:18rpx}.category-panel{background:#fff;padding:32rpx 20rpx}.category-grid{display:grid;grid-template-columns:repeat(5,1fr);row-gap:34rpx}.category{text-align:center;font-size:24rpx}.category-icon{width:88rpx;height:88rpx;border-radius:26rpx;background:linear-gradient(145deg,#e9f5ff,#d8eaff);display:flex;align-items:center;justify-content:center;margin:0 auto 12rpx;font-size:44rpx}.category-icon.all{color:#1677ff;font-weight:700}.promise{margin:22rpx 24rpx;padding:26rpx;background:linear-gradient(100deg,#f3f8ff,#fff);border-radius:22rpx;display:grid;grid-template-columns:repeat(3,1fr);gap:18rpx}.promise view{display:flex;flex-direction:column;font-weight:700;font-size:25rpx}.promise .muted{font-size:20rpx;font-weight:400;line-height:1.4;margin-top:8rpx}.section-head{display:flex;justify-content:space-between;padding:22rpx 28rpx;font-size:34rpx;font-weight:800}.more{font-size:26rpx;color:#667085;font-weight:400}.recommend-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx;padding:0 24rpx}.service-card{background:#fff;border-radius:20rpx;padding:14rpx;box-shadow:0 8rpx 24rpx rgba(15,23,42,.05)}.service-card image{width:100%;height:220rpx;border-radius:14rpx;background:#eef2f6}.service-name{font-weight:700;margin:16rpx 4rpx 8rpx}.price{color:#e5484d;font-size:32rpx;font-weight:800}.price text{font-size:20rpx;color:#667085;font-weight:400}.empty-card,.help{margin:20rpx 24rpx;padding:30rpx;background:#fff;border-radius:20rpx}.help{display:flex;justify-content:space-between;align-items:center;color:#1677ff}.help-title{font-size:30rpx;font-weight:700;color:#1f2329}.cart-float{position:fixed;right:28rpx;bottom:150rpx;width:92rpx;height:92rpx;background:#1677ff;color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:40rpx;box-shadow:0 10rpx 28rpx rgba(22,119,255,.35)}.cart-float text{position:absolute;right:-4rpx;top:-8rpx;background:#e5484d;border-radius:20rpx;min-width:32rpx;height:32rpx;line-height:32rpx;text-align:center;font-size:20rpx}
