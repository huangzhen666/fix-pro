.home{min-height:100vh;padding-bottom:calc(96px + env(safe-area-inset-bottom));background:var(--color-page)}
.brand-row{height:60px;max-height:70px;box-sizing:border-box;padding:0 16px;display:flex;align-items:center;gap:10px;background:var(--color-surface)}
.brand-logo{width:36px;height:36px;flex:none;border-radius:9px}
.brand-slogan{flex:1;min-width:0;font-size:14px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.service-city{flex:none;margin-left:auto;display:flex;align-items:center;gap:4px;white-space:nowrap;font-size:12px;color:var(--color-text-secondary)}
.service-city image{width:14px;height:14px}
.search-sticky{position:sticky;top:0;z-index:30;padding:6px 16px 12px;background:var(--color-surface);border-bottom:1px solid var(--color-border)}
.search{height:44px;box-sizing:border-box;display:flex;align-items:center;gap:10px;padding:0 14px;background:var(--color-page);border-radius:24px;color:var(--color-text-secondary);font-size:14px}
.search image{width:19px;height:19px;flex:none}
.search text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.category-panel{background:var(--color-surface);padding:20px 12px 16px}
.category-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:18px 6px}
.category{display:flex;align-items:center;flex-direction:column;min-width:0;gap:8px;min-height:72px;text-align:center}
.category-icon{width:44px;height:44px;flex:none;display:flex;align-items:center;justify-content:center;background:var(--color-primary-soft);border-radius:14px}
.category-icon image{width:24px;height:24px}
.category-name{font-size:12px;line-height:1.4;word-break:break-all}
.promise{display:flex;justify-content:center;gap:14px;margin-top:18px;color:var(--color-text-secondary);font-size:12px}
.promise view{display:flex;align-items:center;gap:4px;white-space:nowrap}
.promise image{width:13px;height:13px;flex:none}
.recommend-section{padding:20px 16px 0}
.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;font-size:17px;font-weight:600}
.more{display:flex;align-items:center;gap:2px;font-size:12px;font-weight:400;color:var(--color-text-secondary);min-height:36px}
.more image{width:14px;height:14px}
.recommend-list{display:flex;flex-direction:column;gap:12px}
.service-card{display:flex;align-items:center;gap:12px;min-width:0;background:var(--color-surface);border-radius:var(--radius-card);padding:14px}
.service-cover{width:80px;height:80px;flex:none;display:flex;align-items:center;justify-content:center;border-radius:10px;overflow:hidden;background:var(--color-primary-soft)}
.service-image{width:100%;height:100%}
.fallback-icon{width:32px;height:32px}
.service-copy{flex:1;min-width:0}
.service-name{font-size:16px;font-weight:600;line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all}
.service-description{margin-top:5px;color:var(--color-text-secondary);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.service-bottom{display:flex;align-items:center;justify-content:space-between;gap:4px;margin-top:9px}
.price{color:var(--color-price);font-size:19px;font-weight:600;line-height:1.4;word-break:break-all}
.currency{font-size:13px;margin-right:2px}
.unit{font-size:12px;color:var(--color-text-secondary);font-weight:400;margin-left:4px}
.service-arrow{width:16px;height:16px;flex:none}
.state-card{padding:28px 16px;margin:16px;background:var(--color-surface);border-radius:var(--radius-card);text-align:center}
.state-title{font-size:15px;font-weight:500}
.state-description{font-size:13px;color:var(--color-text-secondary);margin-top:6px}
.state-icon{width:32px;height:32px;margin-bottom:10px}
.empty-state{margin:0}
.retry-button{margin:16px auto 0;width:140px;height:42px;line-height:42px;padding:0;background:var(--color-primary-soft);color:var(--color-primary);font-size:14px;border-radius:22px}
.retry-button::after{border:0}
.cart-float{position:fixed;right:16px;bottom:calc(20px + env(safe-area-inset-bottom));z-index:25;display:flex;align-items:center;gap:8px;min-height:44px;padding:0 14px;border:1px solid var(--color-border);border-radius:24px;background:var(--color-surface);color:var(--color-text);font-size:13px;box-shadow:0 3px 12px rgba(31,41,55,.06)}
.cart-icon-wrap{position:relative;width:21px;height:21px;flex:none}
.cart-icon-wrap image{width:21px;height:21px}
.cart-count{position:absolute;right:-8px;top:-10px;min-width:18px;height:18px;line-height:18px;padding:0 4px;box-sizing:border-box;border-radius:10px;background:var(--color-primary);color:var(--color-on-primary);font-size:11px;text-align:center;white-space:nowrap}
@media(max-width:350px){.promise{gap:8px}.promise view{gap:3px}.service-card{padding:12px;gap:10px}.service-cover{width:76px;height:76px}.service-name{font-size:15px}}
