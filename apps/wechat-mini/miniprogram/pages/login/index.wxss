.login{padding:82rpx 48rpx}.login-brand{display:flex;align-items:center;gap:18rpx;color:var(--color-primary);font-size:26px;font-weight:600}.login-brand image{width:150rpx;height:150rpx;border-radius:24rpx;background:var(--color-surface)}.title{font-size:22px;margin:36rpx 0 16rpx}.hint{color:var(--color-text-secondary);margin:24rpx 0;font-size:13px}.login-button{margin-top:64rpx;background:var(--color-primary)!important;border-radius:16rpx}.links{color:var(--color-text-secondary);margin:24rpx 0 44rpx;font-size:12px;line-height:1.8}.links text,.privacy-link{color:var(--color-primary)}.error{color:var(--color-danger);margin:24rpx 0}.browse-button{background:transparent;color:var(--color-text-secondary);font-size:14px}.browse-button::after{border:0}.privacy-mask{position:fixed;inset:0;z-index:1000;background:rgba(16,24,40,.5);display:flex;align-items:center;justify-content:center;padding:48rpx}.privacy-dialog{width:100%;box-sizing:border-box;background:var(--color-surface);border-radius:28rpx;padding:40rpx}.privacy-title{font-size:17px;font-weight:600;text-align:center;margin-bottom:28rpx}.privacy-content{font-size:14px;line-height:1.8;color:var(--color-text-secondary)}.privacy-actions{display:flex;gap:20rpx;margin-top:36rpx}.privacy-actions button{flex:1;min-width:0;font-size:14px;padding:0 12rpx;margin:0;border-radius:12rpx}.privacy-cancel{color:var(--color-text-secondary);background:var(--color-page)}.privacy-confirm{background:var(--color-primary)!important}
.login-brand{font-size:24px;color:var(--color-text);font-weight:600}
.login-brand image{width:64px;height:64px}
