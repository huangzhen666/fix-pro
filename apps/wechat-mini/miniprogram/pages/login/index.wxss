.login{padding:100rpx 48rpx}.brand{font-size:64rpx;color:#1677ff;font-weight:bold}.title{font-size:44rpx;margin:36rpx 0 16rpx}.hint{color:#667085;margin:24rpx 0;font-size:26rpx}.login-button{margin-top:64rpx;background:#1677ff!important;border-radius:16rpx}.links{color:#667085;margin:24rpx 0 44rpx;font-size:24rpx;line-height:1.8}.links text,.privacy-link{color:#1677ff}.error{color:#c33;margin:24rpx 0}.browse-button{background:transparent;color:#667085;font-size:28rpx}.browse-button::after{border:0}.privacy-mask{position:fixed;inset:0;z-index:1000;background:rgba(16,24,40,.5);display:flex;align-items:center;justify-content:center;padding:48rpx}.privacy-dialog{width:100%;box-sizing:border-box;background:#fff;border-radius:28rpx;padding:40rpx}.privacy-title{font-size:34rpx;font-weight:700;text-align:center;margin-bottom:28rpx}.privacy-content{font-size:28rpx;line-height:1.8;color:#475467}.privacy-actions{display:flex;gap:20rpx;margin-top:36rpx}.privacy-actions button{flex:1;min-width:0;font-size:28rpx;padding:0 12rpx;margin:0;border-radius:12rpx}.privacy-cancel{color:#667085;background:#f2f4f7}.privacy-confirm{background:#1677ff!important}
