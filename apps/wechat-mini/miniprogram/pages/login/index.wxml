<view class="login">
  <view class="login-brand"><image src="../../assets/brand/logo-small.png" mode="aspectFit"/><text>灵狸护家</text></view>
  <view class="title">手机号快捷登录</view>
  <view class="hint">未注册手机号将自动创建账号</view>
  <button class="login-button" type="primary" open-type="getPhoneNumber" bindgetphonenumber="login" disabled="{{busy}}" loading="{{busy}}">{{busy ? '登录中…' : '手机号快捷登录'}}</button>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="links">登录即表示同意<text bindtap="terms">《用户协议》</text>与<text bindtap="privacy">《隐私保护指引》</text></view>
  <button class="browse-button" bindtap="browse" disabled="{{busy || showPrivacy}}">暂不登录，继续浏览</button>
  <view class="hint">取消授权后仍可浏览公开服务</view>
</view>
<view wx:if="{{showPrivacy}}" class="privacy-mask" catchtap="stopPropagation" catchtouchmove="stopPropagation">
  <view class="privacy-dialog" role="dialog" aria-label="隐私保护提示">
    <view class="privacy-title">隐私保护提示</view>
    <view class="privacy-content">欢迎使用灵狸护家。为提供手机号登录与维修服务，请先阅读并同意<text class="privacy-link" bindtap="privacy">《{{privacyTitle}}》</text>及<text class="privacy-link" bindtap="terms">《用户协议》</text>。同意后将继续微信手机号授权。</view>
    <view class="privacy-actions">
      <button class="privacy-cancel" bindtap="privacyDeclined">暂不同意</button>
      <button id="privacy-agree" class="privacy-confirm" type="primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="privacyAgreed">同意并继续</button>
    </view>
  </view>
</view>
