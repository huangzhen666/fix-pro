.profile{min-height:100vh;background:linear-gradient(180deg,#e5efff 0,#f5f7fa 430rpx);padding:34rpx 24rpx}.profile-hero{display:flex;align-items:center;padding:40rpx 18rpx 26rpx}.avatar{width:120rpx;height:120rpx;border-radius:50%;background:linear-gradient(145deg,#58b4ff,#1677ff);color:#fff;font-size:58rpx;font-weight:800;display:flex;align-items:center;justify-content:center;border:8rpx solid rgba(255,255,255,.8)}.identity{flex:1;margin-left:24rpx}.name{font-size:36rpx;font-weight:800;margin-bottom:10rpx}.customer{font-size:28rpx;font-weight:700}.address,.order-card,.tools,.service-banner{background:#fff;border-radius:24rpx;margin-bottom:22rpx;padding:28rpx}.address{display:flex;justify-content:space-between;align-items:center}.address-preview{max-width:600rpx;color:#667085;font-size:23rpx;margin-top:8rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.card-title{font-size:32rpx;font-weight:800;display:flex;justify-content:space-between}.more{font-size:24rpx;color:#667085;font-weight:400}.order-actions{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));margin-top:28rpx}.order-action{min-width:0;align-items:center;text-align:center;display:flex;flex-direction:column;gap:6rpx;font-size:22rpx;position:relative;white-space:nowrap;color:#344054}.order-icon{display:block;width:56rpx;height:56rpx;font-size:42rpx;line-height:56rpx}.order-badge{position:absolute;top:-4rpx;left:calc(50% + 10rpx);min-width:32rpx;height:32rpx;padding:0 8rpx;box-sizing:border-box;background:#e5484d;color:#fff;border-radius:18rpx;font-size:21rpx;line-height:32rpx;text-align:center}.tool-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:30rpx}.tool-grid>view{text-align:center;font-size:24rpx;position:relative}.tool-icon{font-size:46rpx;margin-bottom:10rpx}.badge{background:#e5484d;color:#fff;border-radius:18rpx;padding:2rpx 10rpx;margin-left:6rpx}.service-banner{background:linear-gradient(110deg,#1677ff,#62b8ff);color:#fff;padding:36rpx}.banner-title{font-size:36rpx;font-weight:800;margin-bottom:12rpx}
