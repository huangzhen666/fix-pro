.profile{min-height:100vh;background:var(--color-page);padding:34rpx 24rpx}.profile-hero{display:flex;align-items:center;padding:40rpx 18rpx 26rpx}.avatar{width:120rpx;height:120rpx;border-radius:50%;background:var(--color-primary-soft);color:var(--color-on-primary);font-size:29px;font-weight:600;display:flex;align-items:center;justify-content:center;border:8rpx solid rgba(255,255,255,.8)}.identity{flex:1;margin-left:24rpx}.name{font-size:18px;font-weight:600;margin-bottom:10rpx}.address,.order-card,.tools{background:var(--color-surface);border-radius:24rpx;margin-bottom:22rpx;padding:28rpx}.address{display:flex;justify-content:space-between;align-items:center}.address-preview{max-width:600rpx;color:var(--color-text-secondary);font-size:12px;margin-top:8rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.card-title{font-size:16px;font-weight:600;display:flex;justify-content:space-between}.more{font-size:12px;color:var(--color-text-secondary);font-weight:400}.order-actions{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));margin-top:28rpx}.order-action{min-width:0;align-items:center;text-align:center;display:flex;flex-direction:column;gap:6rpx;font-size:12px;position:relative;white-space:nowrap;color:var(--color-text)}.order-icon{display:block;width:56rpx;height:56rpx;font-size:21px;line-height:56rpx}.order-badge{position:absolute;top:-4rpx;left:calc(50% + 10rpx);min-width:32rpx;height:32rpx;padding:0 8rpx;box-sizing:border-box;background:var(--color-price);color:var(--color-on-primary);border-radius:18rpx;font-size:12px;line-height:32rpx;text-align:center}.tool-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:30rpx}.tool-grid>view{text-align:center;font-size:12px;position:relative}.tool-icon{font-size:23px;margin-bottom:10rpx}.badge{background:var(--color-price);color:var(--color-on-primary);border-radius:18rpx;padding:2rpx 10rpx;margin-left:6rpx}
/* Shared-theme adjustments: keep neutral profile surfaces and readable text. */
.avatar{color:var(--color-primary);border-color:var(--color-surface)}
.identity{min-width:0}.identity .name{word-break:break-all}
.tool-icon image,.order-icon image{width:24px;height:24px}
.order-icon,.tool-icon{display:flex;align-items:center;justify-content:center}
.order-badge,.badge{background:var(--color-primary);color:var(--color-on-primary)}
