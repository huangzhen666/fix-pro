<view class="profile"><view class="profile-hero"><view class="avatar" bindtap="editProfile"><image wx:if="{{avatarPath}}" src="{{avatarPath}}" style="width:100%;height:100%;border-radius:50%"/><view wx:else class="default-avatar"><view class="avatar-head"/><view class="avatar-body"/></view></view><view class="identity" bindtap="editProfile"><view class="name">{{displayName}}</view><view class="muted">{{mobileMasked || "手机号快捷登录 / 点击头像编辑"}}</view></view><view class="customer" bindtap="contact">客服 ›</view></view><view class="address" bindtap="openAddresses"><view><view>⌖ 服务地址管理</view><view wx:if="{{defaultAddress}}" class="address-preview">{{defaultAddress.city}}{{defaultAddress.detailAddress}}{{defaultAddress.buildingDoor}}</view><view wx:else class="address-preview">添加常用服务地址</view></view><text>›</text></view><view class="order-card"><view class="card-title"><text>我的订单</text><text class="more" bindtap="openOrders">查看全部 ›</text></view><view class="order-actions"><view class="order-action" data-status="PENDING_PAYMENT" bindtap="openOrders"><text class="order-icon">▣</text><text wx:if="{{orderCounts.pendingPayment > 0}}" class="order-badge">{{orderCounts.pendingPayment}}</text><text>待付款</text></view><view class="order-action" data-status="PENDING_CONFIRMATION" bindtap="openOrders"><text class="order-icon">⌄</text><text wx:if="{{orderCounts.pendingService > 0}}" class="order-badge">{{orderCounts.pendingService}}</text><text>待服务</text></view><view class="order-action" data-status="FULFILLING" bindtap="openOrders"><text class="order-icon">🔧</text><text wx:if="{{orderCounts.inService > 0}}" class="order-badge">{{orderCounts.inService}}</text><text>服务中</text></view><view class="order-action" data-status="COMPLETED" bindtap="openOrders"><text class="order-icon">□</text><text wx:if="{{orderCounts.pendingRating > 0}}" class="order-badge">{{orderCounts.pendingRating}}</text><text>待评价</text></view><view class="order-action" data-status="CANCELLED" bindtap="openOrders"><text class="order-icon">↩</text><text wx:if="{{orderCounts.returned > 0}}" class="order-badge">{{orderCounts.returned}}</text><text>已打回</text></view></view></view><view class="tools"><view class="card-title">常用服务</view><view class="tool-grid"><view bindtap="openCart"><view class="tool-icon">🛒</view><view>购物车<text wx:if="{{cartCount}}" class="badge">{{cartCount}}</text></view></view><view data-name="售后质保" bindtap="placeholder"><view class="tool-icon">🛡️</view><view>售后质保</view></view><view data-name="我的投诉" bindtap="placeholder"><view class="tool-icon">✎</view><view>我的投诉</view></view><view bindtap="contact"><view class="tool-icon">🎧</view><view>联系客服</view></view></view></view><view class="service-banner"><view class="banner-title">专业测漏 · 透明维修</view><view>服务范围、价格边界和质保承诺随订单留存</view></view></view>
