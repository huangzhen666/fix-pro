.editor{padding:40rpx}.avatar{width:160rpx;height:160rpx;border-radius:50%;padding:0;display:flex;align-items:center;justify-content:center;font-size:13px}.avatar image{width:100%;height:100%}.hint{text-align:center;color:var(--color-text-secondary);margin:20rpx}.field{display:flex;justify-content:space-between;gap:30rpx;padding:32rpx 0;border-bottom:1rpx solid var(--color-border)}.field input{text-align:right}.error{color:var(--color-danger);min-height:50rpx;margin-top:30rpx}.editor>button{margin-top:24rpx}
