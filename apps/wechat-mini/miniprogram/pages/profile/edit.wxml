<block wx:if="{{sessionReady}}"><view class="editor"><button open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{saving}}" class="avatar"><image wx:if="{{avatarPath}}" src="{{avatarPath}}" mode="aspectFill"/><view wx:else class="default-avatar"><view class="avatar-head"/><view class="avatar-body"/></view></button><view class="hint">点击头像修改</view><view class="field"><text>昵称</text><input type="nickname" value="{{displayName}}" bindinput="nickname" bindblur="nickname" maxlength="64" disabled="{{saving}}"/></view><view class="field"><text>手机号</text><text>{{mobileMasked}}</text></view><view class="error">{{error}}</view><button type="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button><button bindtap="cancel" disabled="{{saving}}">取消</button></view>
</block>