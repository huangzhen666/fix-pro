.page{padding-bottom:140rpx}.item{margin-bottom:20rpx}.head{display:flex;align-items:center;gap:18rpx}.head image{width:130rpx;height:100rpx;border-radius:10rpx}.grow{flex:1}.name{font-weight:700}.price{color:#e5484d;margin-top:10rpx}.counter{display:flex;align-items:center;gap:10rpx}.counter button{margin:0;padding:0 18rpx}.fault-title{font-weight:700;margin:28rpx 0 12rpx}.state{font-size:22rpx;margin-left:10rpx}.ok{color:#1f9d55}.warn{color:#d97706}textarea{width:100%;height:150rpx;background:#f7f8fa;border-radius:10rpx;padding:16rpx;box-sizing:border-box}.media-row{white-space:nowrap;margin-top:16rpx}.media-wrap,.upload{display:inline-flex;width:150rpx;height:150rpx;vertical-align:top;margin-right:12rpx;position:relative}.media-wrap image,.media-wrap video{width:100%;height:100%;border-radius:8rpx}.delete{position:absolute;right:-4rpx;top:-4rpx;background:#111;color:#fff;width:36rpx;height:36rpx;border-radius:50%;text-align:center}.upload{align-items:center;justify-content:center;white-space:normal}.actions{display:flex;justify-content:flex-end;gap:16rpx;margin-top:20rpx}.actions button{margin:0}.checkout{position:fixed;bottom:0;left:0;right:0;padding:18rpx 28rpx;background:white;display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #eee}.checkout text{font-size:36rpx;color:#e5484d;font-weight:700}.checkout button{margin:0;width:300rpx}.empty{text-align:center;padding:180rpx 40rpx}.empty-title{font-size:34rpx;margin-bottom:30rpx}
