.page{padding:24rpx 20rpx calc(170rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:var(--color-page);min-height:100vh}.loading-card{margin-top:30rpx;padding:36rpx;text-align:center;background:var(--color-surface);border-radius:24rpx;color:var(--color-text-secondary)}.cart-tip{display:flex;justify-content:space-between;margin:0 8rpx 22rpx;color:var(--color-text-secondary);font-size:12px}.cart-tip text{color:var(--color-text-secondary)}.item{margin-bottom:22rpx;background:var(--color-surface);border-radius:20rpx;overflow:hidden}.head{display:flex;align-items:center;gap:24rpx;padding:28rpx}.item-select{width:38rpx;height:38rpx;box-sizing:border-box;flex:none;border:2rpx solid #d0d5dd;border-radius:50%;background:var(--color-surface);color:var(--color-on-primary);text-align:center;font-size:13px;line-height:34rpx}.item-select.selected{border-color:var(--color-primary);background:var(--color-primary)}.name{font-size:15.5px;font-weight:600;color:var(--color-text);line-height:1.5}.swipe-container{position:relative;overflow:hidden;background:var(--color-danger)}.swipe-delete{position:absolute;right:0;top:0;bottom:0;width:144rpx;padding:0;margin:0;display:flex;justify-content:center;align-items:center;background:var(--color-danger);color:var(--color-on-primary);font-size:14.5px;border-radius:0}.swipe-delete::after{border:0}.swipe-delete[disabled]{background:var(--color-danger);color:var(--color-on-primary)}.service-row{position:relative;z-index:1;display:flex;align-items:center;gap:24rpx;padding:8rpx 28rpx 28rpx;background:var(--color-surface);transition:transform .2s ease}.service-row.dragging{transition:none}.cover{width:142rpx;height:150rpx;border-radius:12rpx;background:var(--color-page);flex:none}.grow{flex:1;min-width:0}.unit-price{font-size:12px;color:var(--color-text-secondary)}.detail-entry{position:relative;margin-top:16rpx;padding:8rpx 30rpx 8rpx 12rpx;border-radius:6rpx;background:var(--color-page);color:var(--color-text-secondary);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.detail-entry text{position:absolute;right:12rpx;font-size:14px;line-height:28rpx}.price-row{display:flex;align-items:center;justify-content:space-between;gap:8rpx;margin-top:24rpx}.subtotal{font-size:14.5px;color:var(--color-price);font-weight:600}.counter{display:flex;align-items:center;flex:none;border:1rpx solid var(--color-border);border-radius:30rpx;overflow:hidden}.counter button{width:48rpx;height:46rpx;line-height:43rpx;padding:0;margin:0;border-radius:0;background:var(--color-surface);color:var(--color-text);font-size:15px}.counter button::after{border:0}.counter button[disabled]{color:#d0d5dd}.counter text{min-width:40rpx;text-align:center;color:var(--color-text);font-size:12.5px}.info-block{margin:8rpx 28rpx 0;padding:20rpx;background:var(--color-page);border-radius:16rpx}.info-heading{display:flex;align-items:baseline;gap:12rpx;margin-bottom:14rpx}.info-title{font-size:13.5px;color:var(--color-text);font-weight:600}.optional{color:var(--color-text-secondary);font-size:12px}.info-block textarea{width:100%;height:132rpx;background:var(--color-surface);border:1rpx solid var(--color-border);border-radius:12rpx;padding:18rpx;box-sizing:border-box;font-size:13px}.media-row{white-space:nowrap;margin:18rpx 28rpx 0;width:calc(100% - 56rpx)}.media-wrap,.upload{display:inline-flex;width:132rpx;height:132rpx;vertical-align:top;margin-right:12rpx;position:relative}.media-wrap image,.media-wrap video{width:100%;height:100%;border-radius:14rpx;background:var(--color-page)}.delete{position:absolute;right:0;top:0;background:rgba(16,24,40,.8);color:var(--color-on-primary);width:36rpx;height:36rpx;line-height:34rpx;border-radius:50%;text-align:center;font-size:13.5px}.upload{align-items:center;justify-content:center;flex-direction:column;white-space:normal;border:1rpx dashed var(--color-border);border-radius:14rpx;background:var(--color-primary-soft);color:var(--color-primary);font-size:12px;margin-top:0}.upload-plus{font-size:17px;line-height:38rpx}.item-footer{display:flex;align-items:center;justify-content:space-between;padding:18rpx 28rpx;border-top:1rpx solid #f5f5f5}.supplement-link{color:var(--color-primary);font-size:12px}.supplement-link text{color:var(--color-text-secondary)}.remove-button{margin:0;padding:0;color:var(--color-text-secondary);background:transparent;font-size:12px;line-height:42rpx}.remove-button::after{border:0}.syncing{color:var(--color-text-secondary);font-size:12px}.list-end{text-align:center;color:var(--color-text-secondary);font-size:12.5px;padding:30rpx 0}.checkout{position:fixed;bottom:0;left:0;right:0;z-index:10;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:var(--color-surface);display:flex;align-items:center;gap:20rpx;border-top:1rpx solid var(--color-border)}.select-all{display:flex;align-items:center;gap:12rpx;font-size:12px;color:var(--color-text)}.total{flex:1;text-align:right;min-width:0}.total-label{font-size:12px;color:var(--color-text-secondary)}.total>text{font-size:17px;color:var(--color-price);font-weight:600}.checkout button{margin:0;width:230rpx;flex:none;padding:0;height:78rpx;line-height:78rpx;border-radius:40rpx;background:var(--color-primary);font-size:13.5px}.checkout button[disabled]{background:var(--color-primary-disabled);color:var(--color-on-primary)}.empty{text-align:center;padding:220rpx 40rpx}.empty-icon{font-size:40px;margin-bottom:22rpx}.empty-title{font-size:17px;color:var(--color-text);font-weight:600}.empty-desc{font-size:12.5px;color:var(--color-text-secondary);margin:12rpx 0 30rpx}.go-service{width:300rpx;margin:0 auto;border-radius:40rpx;background:var(--color-primary);color:var(--color-on-primary)}.session-loading{padding:40rpx;text-align:center;color:var(--color-text-secondary)}

.item-select.disabled{background:var(--color-page);border-color:var(--color-border)}.unavailable .name,.unavailable .subtotal{color:var(--color-text-secondary)}.unavailable .cover{opacity:.5}.unavailable-label{flex:none;margin-left:auto;color:var(--color-text-secondary);font-size:12px}
.page{padding:16px 16px calc(110px + env(safe-area-inset-bottom))}
.item{border-radius:var(--radius-card)}
.cart-tip{font-size:12px;gap:12px}.cart-tip text{white-space:nowrap}
.name{min-width:0;word-break:break-all}
.cover{width:64px;height:72px}
.price-row{flex-wrap:wrap;row-gap:8px}
.counter button{width:28px;height:32px;line-height:30px}
.counter text{min-width:24px}
.checkout{padding:12px 16px calc(12px + env(safe-area-inset-bottom));gap:12px}
.checkout button{width:112px;height:44px;line-height:44px;font-size:14px}
.total>text{font-size:18px;word-break:break-all}
.empty-icon image{width:48px;height:48px}
.swipe-delete[disabled]{opacity:.5}
.upload{font-size:12px;color:var(--color-primary)}
.counter button{width:44px;height:44px;line-height:42px;font-size:18px}
