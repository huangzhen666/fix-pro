.page{padding:24rpx 20rpx calc(170rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f5f5f7;min-height:100vh}.loading-card{margin-top:30rpx;padding:36rpx;text-align:center;background:#fff;border-radius:24rpx;color:#98a2b3}.cart-tip{display:flex;justify-content:space-between;margin:0 8rpx 22rpx;color:#667085;font-size:24rpx}.cart-tip text{color:#98a2b3}.item{margin-bottom:22rpx;background:#fff;border-radius:20rpx;overflow:hidden}.head{display:flex;align-items:center;gap:24rpx;padding:28rpx}.item-select{width:38rpx;height:38rpx;box-sizing:border-box;flex:none;border:2rpx solid #d0d5dd;border-radius:50%;background:#fff;color:#fff;text-align:center;font-size:26rpx;line-height:34rpx}.item-select.selected{border-color:#1677ff;background:#1677ff}.name{font-size:31rpx;font-weight:600;color:#262626;line-height:1.5}.swipe-container{position:relative;overflow:hidden;background:#ff5b5b}.swipe-delete{position:absolute;right:0;top:0;bottom:0;width:144rpx;padding:0;margin:0;display:flex;justify-content:center;align-items:center;background:#ff5b5b;color:#fff;font-size:29rpx;border-radius:0}.swipe-delete::after{border:0}.swipe-delete[disabled]{background:#ff8585;color:#fff}.service-row{position:relative;z-index:1;display:flex;align-items:center;gap:24rpx;padding:8rpx 28rpx 28rpx;background:#fff;transition:transform .2s ease}.service-row.dragging{transition:none}.cover{width:142rpx;height:150rpx;border-radius:12rpx;background:#f2f4f7;flex:none}.grow{flex:1;min-width:0}.unit-price{font-size:24rpx;color:#667085}.detail-entry{position:relative;margin-top:16rpx;padding:8rpx 30rpx 8rpx 12rpx;border-radius:6rpx;background:#f7f7f7;color:#98a2b3;font-size:23rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.detail-entry text{position:absolute;right:12rpx;font-size:28rpx;line-height:28rpx}.price-row{display:flex;align-items:center;justify-content:space-between;gap:8rpx;margin-top:24rpx}.subtotal{font-size:29rpx;color:#e5484d;font-weight:600}.counter{display:flex;align-items:center;flex:none;border:1rpx solid #eaecf0;border-radius:30rpx;overflow:hidden}.counter button{width:48rpx;height:46rpx;line-height:43rpx;padding:0;margin:0;border-radius:0;background:#fff;color:#344054;font-size:30rpx}.counter button::after{border:0}.counter button[disabled]{color:#d0d5dd}.counter text{min-width:40rpx;text-align:center;color:#344054;font-size:25rpx}.info-block{margin:8rpx 28rpx 0;padding:20rpx;background:#f7f9fc;border-radius:16rpx}.info-heading{display:flex;align-items:baseline;gap:12rpx;margin-bottom:14rpx}.info-title{font-size:27rpx;color:#101828;font-weight:600}.optional{color:#98a2b3;font-size:22rpx}.info-block textarea{width:100%;height:132rpx;background:#fff;border:1rpx solid #eaecf0;border-radius:12rpx;padding:18rpx;box-sizing:border-box;font-size:26rpx}.media-row{white-space:nowrap;margin:18rpx 28rpx 0;width:calc(100% - 56rpx)}.media-wrap,.upload{display:inline-flex;width:132rpx;height:132rpx;vertical-align:top;margin-right:12rpx;position:relative}.media-wrap image,.media-wrap video{width:100%;height:100%;border-radius:14rpx;background:#f2f4f7}.delete{position:absolute;right:0;top:0;background:rgba(16,24,40,.8);color:#fff;width:36rpx;height:36rpx;line-height:34rpx;border-radius:50%;text-align:center;font-size:27rpx}.upload{align-items:center;justify-content:center;flex-direction:column;white-space:normal;border:1rpx dashed #b2c7e8;border-radius:14rpx;background:#f7faff;color:#5b8fdc;font-size:20rpx;margin-top:0}.upload-plus{font-size:34rpx;line-height:38rpx}.item-footer{display:flex;align-items:center;justify-content:space-between;padding:18rpx 28rpx;border-top:1rpx solid #f5f5f5}.supplement-link{color:#1677ff;font-size:24rpx}.supplement-link text{color:#98a2b3}.remove-button{margin:0;padding:0;color:#98a2b3;background:transparent;font-size:23rpx;line-height:42rpx}.remove-button::after{border:0}.syncing{color:#98a2b3;font-size:22rpx}.list-end{text-align:center;color:#aaa;font-size:25rpx;padding:30rpx 0}.checkout{position:fixed;bottom:0;left:0;right:0;z-index:10;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;display:flex;align-items:center;gap:20rpx;border-top:1rpx solid #eaecf0}.select-all{display:flex;align-items:center;gap:12rpx;font-size:24rpx;color:#344054}.total{flex:1;text-align:right;min-width:0}.total-label{font-size:22rpx;color:#667085}.total>text{font-size:34rpx;color:#e5484d;font-weight:700}.checkout button{margin:0;width:230rpx;flex:none;padding:0;height:78rpx;line-height:78rpx;border-radius:40rpx;background:#1677ff;font-size:27rpx}.checkout button[disabled]{background:#91caff;color:#fff}.empty{text-align:center;padding:220rpx 40rpx}.empty-icon{font-size:80rpx;margin-bottom:22rpx}.empty-title{font-size:34rpx;color:#101828;font-weight:700}.empty-desc{font-size:25rpx;color:#98a2b3;margin:12rpx 0 30rpx}.go-service{width:300rpx;margin:0 auto;border-radius:40rpx;background:#1677ff;color:#fff}.session-loading{padding:40rpx;text-align:center;color:#888}

.item-select.disabled{background:#f2f4f7;border-color:#eaecf0}.unavailable .name,.unavailable .subtotal{color:#98a2b3}.unavailable .cover{opacity:.5}.unavailable-label{flex:none;margin-left:auto;color:#98a2b3;font-size:23rpx}
