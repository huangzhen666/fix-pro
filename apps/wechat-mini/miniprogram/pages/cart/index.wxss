.page{padding:28rpx 24rpx 170rpx;box-sizing:border-box;background:linear-gradient(180deg,#f4f8ff 0,#f5f7fa 420rpx);min-height:100vh}.loading-card{margin-top:30rpx;padding:36rpx;text-align:center;background:#fff;border-radius:24rpx;color:#98a2b3}.page-heading{display:flex;align-items:baseline;gap:14rpx;padding:8rpx 8rpx 26rpx}.page-title{font-size:42rpx;font-weight:800;color:#101828}.page-subtitle{font-size:25rpx;color:#98a2b3}.item{margin-bottom:22rpx;padding:26rpx 24rpx}.head{display:flex;align-items:center;gap:18rpx}.cover{width:142rpx;height:118rpx;border-radius:16rpx;background:#f2f4f7;flex:none}.grow{flex:1;min-width:0}.name{font-size:30rpx;font-weight:700;color:#101828;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.unit-price{font-size:23rpx;color:#98a2b3;margin-top:8rpx}.subtotal{font-size:31rpx;color:#e5484d;font-weight:800;margin-top:8rpx}.counter{display:flex;align-items:center;gap:12rpx;margin-left:10rpx}.counter button{width:50rpx;height:50rpx;line-height:46rpx;padding:0;margin:0;border:1rpx solid #d0d5dd;border-radius:12rpx;background:#fff;color:#344054;font-size:30rpx}.counter text{min-width:30rpx;text-align:center;color:#344054;font-size:27rpx}.info-block{margin-top:26rpx;padding:22rpx;background:#f7f9fc;border-radius:16rpx}.info-heading{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14rpx}.info-title{font-size:29rpx;color:#101828;font-weight:700}.optional{margin-left:12rpx;color:#98a2b3;font-size:22rpx}.info-tip{color:#98a2b3;font-size:22rpx}.info-block textarea{width:100%;height:132rpx;background:#fff;border:1rpx solid #eaecf0;border-radius:12rpx;padding:18rpx;box-sizing:border-box;font-size:26rpx}.media-row{white-space:nowrap;margin-top:18rpx}.media-wrap,.upload{display:inline-flex;width:148rpx;height:148rpx;vertical-align:top;margin-right:12rpx;position:relative}.media-wrap image,.media-wrap video{width:100%;height:100%;border-radius:14rpx;background:#f2f4f7}.delete{position:absolute;right:-4rpx;top:-4rpx;background:rgba(16,24,40,.8);color:#fff;width:38rpx;height:38rpx;line-height:36rpx;border-radius:50%;text-align:center;font-size:27rpx}.upload{align-items:center;justify-content:center;flex-direction:column;white-space:normal;border:1rpx dashed #b2c7e8;border-radius:14rpx;background:#f7faff;color:#5b8fdc;font-size:22rpx}.upload-plus{font-size:34rpx;line-height:38rpx}.upload-optional{color:#98a2b3;font-size:20rpx;margin-top:5rpx}.item-footer{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx}.remove-button{margin:0;padding:0;color:#98a2b3;background:transparent;font-size:24rpx}.remove-button:after{border:0}.syncing{color:#98a2b3;font-size:22rpx}.checkout{position:fixed;bottom:0;left:0;right:0;z-index:10;padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.96);backdrop-filter:blur(12rpx);display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #eaecf0}.total-label{font-size:23rpx;color:#667085}.checkout text{font-size:38rpx;color:#e5484d;font-weight:800}.checkout button{margin:0;width:300rpx;height:82rpx;line-height:82rpx;border-radius:41rpx;background:#1677ff}.empty{text-align:center;padding:220rpx 40rpx}.empty-icon{font-size:80rpx;margin-bottom:22rpx}.empty-title{font-size:34rpx;color:#101828;font-weight:700}.empty-desc{font-size:25rpx;color:#98a2b3;margin:12rpx 0 30rpx}.go-service{width:300rpx;margin:0 auto;border-radius:40rpx;background:#1677ff;color:#fff}
