@import "../../styles/quantity.wxss";
.page { padding: 16px 16px calc(96px + env(safe-area-inset-bottom)); }
.item { margin-bottom: 12px; border-radius: var(--radius-card); overflow: hidden; background: var(--color-surface); }
.swipe-container { position: relative; overflow: hidden; background: var(--color-surface); }
.swipe-delete { position: absolute; right: 0; top: 0; bottom: 0; width: 144rpx; margin: 0; padding: 0; border-radius: 0; display: flex; align-items: center; justify-content: center; background: var(--color-danger); color: #fff; font-size: 14px; }
.swipe-delete::after, .item-select::after, .select-all::after, .version-status button::after { border: 0; }
.service-row { position: relative; z-index: 1; display: flex; align-items: center; gap: 10px; padding: 12px 12px 12px 0; background: var(--color-surface); transition: transform .2s ease; }
.service-row.dragging { transition: none; }
.item-select { flex: 0 0 44px; width: 44px; min-height: 56px; padding: 0; margin: 0 -6px 0 0; display: flex; align-items: center; justify-content: center; background: transparent; border-radius: 0; }
.check-circle { width: 18px; height: 18px; box-sizing: border-box; flex: none; border: 1px solid var(--color-border); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 12px; line-height: 1; }
.check-circle.selected { background: var(--color-primary); border-color: var(--color-primary); }
.item-select[disabled] { background: transparent; opacity: .45; }
.cover { width: 56px; height: 56px; flex: 0 0 56px; border-radius: 8px; overflow: hidden; background: var(--color-page); display: flex; align-items: center; justify-content: center; }
.cover image { width: 100%; height: 100%; }
.cover-placeholder { font-size: 12px; color: var(--color-text-secondary); }
.service-info { flex: 1; min-width: 0; }
.name { color: var(--color-text); font-size: 15px; font-weight: 600; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-all; }
.price-quantity { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.unit-price { font-size: 13px; font-weight: 600; line-height: 1.5; color: var(--color-price); overflow-wrap: anywhere; min-width: 0; }
.unit { font-size: 12px; font-weight: 400; color: var(--color-text-secondary); }
.counter { flex-shrink: 0; margin-left: auto; }
.status { margin-top: 8px; font-size: 12px; line-height: 1.6; color: var(--color-text-secondary); }
.unavailable .cover, .unavailable .name, .unavailable .unit-price { opacity: .5; }
.version-status { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.version-status button { margin: 0; padding: 4px 0; font-size: 12px; line-height: 1.6; color: var(--color-primary); background: transparent; }
.checkout { position: fixed; bottom: 0; left: 0; right: 0; z-index: 50; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 12px; border-top: 1rpx solid var(--color-border); background: var(--color-surface); }
.select-all { display: flex; align-items: center; justify-content: flex-start; gap: 6px; flex: 0 0 64px; box-sizing: border-box; width: 64px; min-height: 44px; margin: 0; padding: 0; background: transparent; border-radius: 0; font-size: 12px; line-height: normal; color: var(--color-text); }
.select-all[disabled] { background: transparent; color: var(--color-text-secondary); }
.checkout-submit { width: 112px; min-height: 44px; line-height: 44px; font-size: 14px; flex: none; margin: 0; padding: 0; border-radius: 40rpx; background: var(--color-primary); }
.checkout-submit[disabled] { background: var(--color-primary-disabled); color: #fff; }
.total { flex: 1; text-align: right; min-width: 0; }
.total-label { font-size: 12px; color: var(--color-text-secondary); }
.total > text { font-size: 18px; color: var(--color-price); font-weight: 600; overflow-wrap: anywhere; }
.state-card { padding: 32px 16px; background: var(--color-surface); border-radius: 12px; color: var(--color-text-secondary); font-size: 14px; text-align: center; }
.empty { display: flex; align-items: center; flex-direction: column; gap: 12px; }
.empty-title { font-size: 16px; font-weight: 600; color: var(--color-text); }
.empty button, .retry { margin: 12px auto 0; width: 140px; font-size: 14px; }
.refresh-error { margin-bottom: 12px; font-size: 13px; color: var(--color-text-secondary); }
