<view class="page"><view wx:if="{{loading}}" class="card muted">加载购物车…</view><view wx:elif="{{!cart.items.length}}" class="empty"><view class="empty-title">购物车还是空的</view><button bindtap="goServices">去选择维修服务</button></view><block wx:else><view class="card item" wx:for="{{cart.items}}" wx:key="id" wx:for-index="index"><view class="head"><image src="{{item.coverImageUrl}}" mode="aspectFill"/><view class="grow"><view class="name">{{item.name}}</view><view class="price">¥{{item.subtotalText}}</view></view><view class="counter"><button size="mini" data-index="{{index}}" data-delta="-1" bindtap="change">−</button><text>{{item.quantity}}</text><button size="mini" data-index="{{index}}" data-delta="1" bindtap="change">+</button></view></view><view class="fault-title">故障资料 <text class="state {{item.faultComplete?'ok':'warn'}}">{{item.faultComplete?'已完整':'待完善'}}</text></view><textarea value="{{item.faultDescription}}" data-index="{{index}}" bindinput="inputFault" maxlength="500" placeholder="请描述漏水位置、现象和持续时间（至少5字）"/><scroll-view scroll-x class="media-row"><view class="media-wrap" wx:for="{{item.faultMedia}}" wx:key="id" wx:for-item="media" wx:for-index="mediaIndex"><image wx:if="{{media.mediaType==='IMAGE'}}" src="{{media.localUrl}}" mode="aspectFill"/><video wx:else src="{{media.localUrl}}" controls/><view class="delete" data-index="{{index}}" data-media-index="{{mediaIndex}}" catchtap="removeMedia">×</view></view><button class="upload" size="mini" data-index="{{index}}" bindtap="choose">+ 图片/视频</button></scroll-view><view class="actions"><button size="mini" data-index="{{index}}" bindtap="remove">移除</button><button size="mini" type="primary" loading="{{savingId===item.id}}" data-index="{{index}}" bindtap="save">保存故障资料</button></view></view><view class="checkout"><view>合计 <text>¥{{totalText}}</text></view><button type="primary" bindtap="checkout">去结算</button></view></block></view>
