<view class="page">
  <view wx:if="{{loading}}" class="loading-card">正在加载购物车…</view>
  <view wx:elif="{{!cart.items.length}}" class="empty"><view class="empty-icon">🛒</view><view class="empty-title">购物车还是空的</view><view class="empty-desc">先去挑选需要的维修服务吧</view><button class="go-service" bindtap="goServices">去选择服务</button></view>
  <block wx:else>
    <view class="page-heading"><view class="page-title">购物车</view><view class="page-subtitle">共 {{cart.itemCount}} 项服务</view></view>
    <view class="card item" wx:for="{{cart.items}}" wx:key="id" wx:for-index="index">
      <view class="head"><image class="cover" src="{{item.coverImageUrl}}" mode="aspectFill"/><view class="grow"><view class="name">{{item.name}}</view><view class="unit-price">¥{{item.unitPrice/100}} / {{item.unit}}</view><view class="subtotal">¥{{item.subtotalText}}</view></view><view class="counter"><button data-index="{{index}}" data-delta="-1" bindtap="change">−</button><text>{{item.quantity}}</text><button data-index="{{index}}" data-delta="1" bindtap="change">+</button></view></view>
      <view class="info-block"><view class="info-heading"><view><text class="info-title">补充信息</text><text class="optional">选填</text></view><text class="info-tip">描述现状，帮助师傅提前判断</text></view><textarea value="{{item.faultDescription}}" data-index="{{index}}" bindinput="inputFault" bindblur="blurFault" maxlength="500" placeholder="可描述当前现状、异常表现、发生时间等"/></view>
      <scroll-view scroll-x class="media-row"><view class="media-wrap" wx:for="{{item.faultMedia}}" wx:key="id" wx:for-item="media" wx:for-index="mediaIndex"><image wx:if="{{media.mediaType==='IMAGE'}}" src="{{media.localUrl}}" mode="aspectFill"/><video wx:else src="{{media.localUrl}}" controls/><view class="delete" data-index="{{index}}" data-media-index="{{mediaIndex}}" catchtap="removeMedia">×</view></view><button class="upload" data-index="{{index}}" bindtap="choose"><text class="upload-plus">＋</text><text>添加图片/视频</text><text class="upload-optional">选填</text></button></scroll-view>
      <view class="item-footer"><button class="remove-button" data-index="{{index}}" bindtap="remove">移除服务</button><text wx:if="{{savingId===item.id}}" class="syncing">正在同步…</text></view>
    </view>
    <view class="checkout"><view><view class="total-label">合计</view><text>¥{{totalText}}</text></view><button type="primary" loading="{{checkoutLoading}}" bindtap="checkout">去结算</button></view>
  </block>
</view>
