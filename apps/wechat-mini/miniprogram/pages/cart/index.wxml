<block wx:if="{{sessionReady}}"><view class="page">
  <view wx:if="{{loading}}" class="loading-card">正在加载购物车…</view>
  <view wx:elif="{{!cart.items.length}}" class="empty"><view class="empty-icon"><image src="/assets/icons/cart.svg" mode="aspectFit"/></view><view class="empty-title">购物车还是空的</view><view class="empty-desc">先去挑选需要的服务吧</view><button class="go-service" bindtap="goServices">去选择服务</button></view>
  <block wx:else>
    <view class="cart-tip">共 {{cart.items.length}} 项服务<text>左滑服务可删除</text></view>
    <view class="item {{!item.available ? 'unavailable' : ''}}" wx:for="{{cart.items}}" wx:key="id" wx:for-index="index">
      <view class="head"><view class="item-select {{!item.available ? 'disabled' : ''}} {{item.selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="toggleSelected" role="checkbox" aria-checked="{{item.selected}}" aria-disabled="{{!item.available}}" aria-label="选择{{item.name}}"><text wx:if="{{item.selected}}">✓</text></view><view class="name">{{item.name}}</view><text wx:if="{{!item.available}}" class="unavailable-label">已下架</text></view>
      <view class="swipe-container">
        <button class="swipe-delete" data-index="{{index}}" catchtap="remove" disabled="{{updatingId || savingId || checkoutLoading}}">删除</button>
        <view class="service-row {{dragging && swipeId === item.id ? 'dragging' : ''}}" style="transform:translateX({{swipeId === item.id ? -swipeOffset : 0}}px)" data-id="{{item.id}}" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel">
          <image class="cover" src="{{item.coverImageUrl}}" mode="aspectFill"/>
          <view class="grow">
            <view class="unit-price">单价 ¥{{item.unitPrice/100}} / {{item.unit}}</view>
            <view class="detail-entry" data-id="{{item.id}}" bindtap="toggleDetails">{{item.demandDescription || (item.demandMedia.length ? '已添加图片/视频' : '查看服务约定 / 补充需求')}}<text>›</text></view>
            <view class="price-row"><view class="subtotal">¥{{item.subtotalText}}</view><view class="counter"><button data-index="{{index}}" data-delta="-1" catchtap="change" disabled="{{!item.available || item.quantity <= item.detailProfile.billing.quantity.min || updatingId || savingId || checkoutLoading}}">−</button><text>{{item.quantity}}</text><button data-index="{{index}}" data-delta="1" catchtap="change" disabled="{{!item.available || item.quantity + item.detailProfile.billing.quantity.step > item.detailProfile.billing.quantity.max || updatingId || savingId || checkoutLoading}}">+</button></view></view>
          </view>
        </view>
      </view>
      <view wx:if="{{item.needsConfirmation}}" class="info-block"><text>服务内容已更新，请查看新版详情并确认。</text><navigator url="/pages/services/detail?id={{item.skuId}}">查看当前服务</navigator><button data-id="{{item.id}}" bindtap="confirmVersion">确认使用新版</button></view>
      <block wx:if="{{expandedId === item.id}}"><service-profile profile="{{item.detailProfile}}"/>
        <view wx:if="{{item.detailProfile.demandCollection.description.mode !== 'HIDDEN'}}" class="info-block"><view class="info-heading"><text class="info-title">{{item.detailProfile.demandCollection.description.label}}</text><text class="optional">{{item.detailProfile.demandCollection.description.mode === 'REQUIRED' ? '必填' : '选填'}}</text></view><textarea value="{{item.demandDescription}}" data-index="{{index}}" bindinput="inputDemand" bindblur="blurDemand" maxlength="500" placeholder="{{item.detailProfile.demandCollection.description.hint}}" disabled="{{updatingId || checkoutLoading}}"/></view>
        <view wx:if="{{item.detailProfile.demandCollection.media.mode !== 'HIDDEN'}}" class="muted">{{item.detailProfile.demandCollection.media.label}} · {{item.detailProfile.demandCollection.media.mode === 'REQUIRED' ? '必填' : '选填'}} · {{item.detailProfile.demandCollection.media.hint}}</view><scroll-view wx:if="{{item.detailProfile.demandCollection.media.mode !== 'HIDDEN'}}" scroll-x class="media-row"><view class="media-wrap" wx:for="{{item.demandMedia}}" wx:key="id" wx:for-item="media" wx:for-index="mediaIndex"><image wx:if="{{media.mediaType==='IMAGE'}}" src="{{media.localUrl}}" mode="aspectFill"/><video wx:else src="{{media.localUrl}}" controls/><view class="delete" data-index="{{index}}" data-media-index="{{mediaIndex}}" catchtap="removeMedia">×</view></view><button class="upload" data-index="{{index}}" bindtap="choose"><text class="upload-plus">＋</text><text>添加图片/视频</text></button></scroll-view>
      </block>
      <view class="item-footer"><text wx:if="{{savingId===item.id}}" class="syncing">正在同步…</text><text wx:elif="{{updatingId===item.id}}" class="syncing">正在更新…</text><view wx:else class="supplement-link" data-id="{{item.id}}" bindtap="toggleDetails">{{expandedId === item.id ? '收起补充信息' : '补充信息'}}<text> · 按服务要求</text></view><button class="remove-button" data-index="{{index}}" bindtap="remove" disabled="{{updatingId || savingId || checkoutLoading}}">删除</button></view>
    </view>
    <view class="list-end">已经到底啦～</view>
    <view class="checkout"><view class="select-all" bindtap="toggleAll"><view class="item-select {{allSelected ? 'selected' : ''}}"><text wx:if="{{allSelected}}">✓</text></view><text>全选</text></view><view class="total"><view class="total-label">合计</view><text>¥{{totalText}}</text></view><button type="primary" loading="{{checkoutLoading}}" disabled="{{!selectedCount || savingId || updatingId || checkoutLoading}}" bindtap="checkout">去结算({{selectedCount}})</button></view>
  </block>
</view></block>
<view wx:else class="session-loading">正在校验登录状态，请保持网络连接</view>
