<block wx:if="{{sessionReady}}">
  <view class="page">
    <view wx:if="{{loading && !cart.items.length}}" class="state-card">正在加载购物车…</view>
    <view wx:elif="{{loadError && !cart.items.length}}" class="state-card">
      <text>{{loadError}}</text><button class="retry" bindtap="load">重新加载</button>
    </view>
    <view wx:elif="{{!cart.items.length}}" class="state-card empty">
      <text class="empty-title">购物车还是空的</text><text>选一项需要的服务吧</text>
      <button type="primary" bindtap="goServices">去选服务</button>
    </view>
    <block wx:else>
      <view wx:if="{{loadError}}" class="refresh-error" bindtap="load">{{loadError}}，点击重试</view>
      <view wx:for="{{cart.items}}" wx:key="id" class="item {{!item.available ? 'unavailable' : ''}}">
        <view class="swipe-container">
          <button class="swipe-delete" data-id="{{item.id}}" bindtap="remove" disabled="{{!!updatingId || checkoutLoading}}">删除</button>
          <view class="service-row {{dragging ? 'dragging' : ''}}" style="transform:translateX(-{{swipeId === item.id ? swipeOffset : 0}}px)" data-id="{{item.id}}" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel" bindlongpress="longPress">
            <button data-control="true" class="item-select" data-id="{{item.id}}" bindtap="toggleSelected" disabled="{{!item.available || checkoutLoading}}" role="checkbox" aria-checked="{{item.selected}}" aria-label="选择{{item.name}}">
              <view data-control="true" class="check-circle {{item.selected ? 'selected' : ''}}"><text data-control="true" wx:if="{{item.selected}}">✓</text></view>
            </button>
            <view class="cover" data-id="{{item.id}}" bindtap="openDetail">
              <image wx:if="{{item.coverImageUrl}}" src="{{item.coverImageUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="imageError" />
              <text wx:else class="cover-placeholder">服务</text>
            </view>
            <view class="service-info">
              <view class="name" data-id="{{item.id}}" bindtap="openDetail">{{item.name}}</view>
              <view class="price-quantity">
                <view class="unit-price">¥{{item.unitPriceText}}<text class="unit"> / {{item.unit}}</text></view>
                <view data-control="true" class="counter">
                  <button data-control="true" data-id="{{item.id}}" data-delta="-1" bindtap="change" disabled="{{item.quantity <= 1 || !item.available || !!updatingId || checkoutLoading}}" aria-label="减少数量">−</button>
                  <text data-control="true">{{item.quantity}}</text>
                  <button data-control="true" data-id="{{item.id}}" data-delta="1" bindtap="change" disabled="{{item.quantity >= 9999 || !item.available || !!updatingId || checkoutLoading}}" aria-label="增加数量">＋</button>
                </view>
              </view>
              <view wx:if="{{!item.available}}" class="status">服务已下架</view>
              <view wx:elif="{{item.needsConfirmation}}" class="status version-status">
                <text>服务已更新</text>
                <button data-control="true" data-id="{{item.id}}" bindtap="openDetail">查看新版</button>
                <button data-control="true" data-id="{{item.id}}" bindtap="confirmVersion" disabled="{{!!updatingId || checkoutLoading}}">确认新版</button>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="checkout">
        <button class="select-all" bindtap="toggleAll" disabled="{{checkoutLoading}}" role="checkbox" aria-checked="{{allSelected}}" aria-label="全选购物车服务">
          <view class="check-circle {{allSelected ? 'selected' : ''}}"><text wx:if="{{allSelected}}">✓</text></view><text>全选</text>
        </button>
        <view class="total"><view class="total-label">合计</view><text>¥{{totalText}}</text></view>
        <button class="checkout-submit" type="primary" loading="{{checkoutLoading}}" disabled="{{!selectedCount || !!updatingId || checkoutLoading}}" bindtap="checkout">去结算({{selectedCount}})</button>
      </view>
    </block>
  </view>
</block>
<view wx:else class="session-loading">正在准备登录状态…</view>
