<block wx:if="{{sessionReady}}">
  <view class="page">
    <view class="privacy-tip">地址信息仅用于上门服务，隐私信息将严格保密</view>
    <view class="form-card">
      <picker mode="selector" range="{{cityOptions}}" value="{{cityIndex}}" bindchange="cityChange" disabled="{{saving || locating}}" aria-label="选择所在城市">
        <view class="form-row"><text class="label">所在城市</text><text class="field city">{{form.city}}</text><text class="city-arrow">⌄</text></view>
      </picker>
      <view class="form-row address-row">
        <text class="label">具体地址</text>
        <input class="field" placeholder-class="placeholder" placeholder="请填写街道/小区/办公楼" maxlength="255" value="{{form.detailAddress}}" data-field="detailAddress" bindinput="input" disabled="{{saving}}"/>
        <button class="location-button" bindtap="chooseLocation" disabled="{{locating || saving}}" aria-label="使用微信定位选择具体地址"><view class="location-pin"/><text>{{locating ? '选址中' : '定位'}}</text></button>
      </view>
      <view class="form-row"><text class="label">楼号/门牌号</text><input class="field" placeholder-class="placeholder" placeholder="例：6号楼203室" maxlength="128" value="{{form.buildingDoor}}" data-field="buildingDoor" bindinput="input" disabled="{{saving}}"/></view>
      <view class="form-row"><text class="label">联系人</text><input class="field" placeholder-class="placeholder" placeholder="请填写联系人姓名" maxlength="64" value="{{form.contactName}}" data-field="contactName" bindinput="input" disabled="{{saving}}"/></view>
      <view class="form-row"><text class="label">手机号码</text><input class="field" placeholder-class="placeholder" type="number" maxlength="11" placeholder="请填写手机号码" value="{{form.contactMobile}}" data-field="contactMobile" bindinput="input" disabled="{{saving}}"/><button wx:if="{{form.contactMobile}}" class="clear-button" bindtap="clearMobile" disabled="{{saving}}" aria-label="清空手机号码">×</button></view>
      <view class="notice">订单信息将开放给联系人，请谨慎填写</view>
    </view>
    <view class="default-row"><text>设为默认地址</text><switch checked="{{form.isDefault}}" color="#1677ff" bindchange="defaultChange" disabled="{{saving}}"/></view>
    <button class="save-button" loading="{{saving}}" disabled="{{saving || locating}}" bindtap="save">保存</button>
  </view>
</block>
<view wx:else class="loading">正在校验登录状态，请保持网络连接</view>
<view wx:if="{{showPrivacy}}" class="privacy-mask" catchtap="stopPropagation" catchtouchmove="stopPropagation">
  <view class="privacy-dialog" role="dialog" aria-label="位置隐私授权">
    <view class="privacy-title">位置隐私授权</view>
    <view class="privacy-content">为帮助您选择上门服务地址，请阅读并同意<text class="privacy-link" bindtap="privacy">《{{privacyTitle}}》</text>。同意后将打开微信地图选择位置，您也可以暂不同意并手动填写。</view>
    <view class="privacy-actions">
      <button class="privacy-cancel" bindtap="privacyDeclined">手动填写</button>
      <button id="address-privacy-agree" class="privacy-confirm" type="primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="privacyAgreed">同意并继续</button>
    </view>
  </view>
</view>
