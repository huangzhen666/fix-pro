.page{min-height:100vh;background:var(--color-page);padding:0 24rpx 60rpx;box-sizing:border-box}
.privacy-tip{margin:0 -24rpx 24rpx;padding:24rpx;background:var(--color-primary-soft);color:var(--color-primary);font-size:12.5px;line-height:1.5}
.form-card{background:var(--color-surface);border-radius:24rpx;padding:16rpx 24rpx 22rpx}
.form-row{display:flex;align-items:center;min-height:92rpx;gap:12rpx}
.label{width:148rpx;flex:none;color:var(--color-text);font-size:14px;font-weight:600;white-space:nowrap}
.field{flex:1;min-width:0;color:var(--color-text);font-size:14px;text-align:left;height:60rpx;line-height:60rpx}
.city-arrow{flex:none;color:var(--color-text-secondary);font-size:16px;padding:0 4rpx}
.placeholder{color:var(--color-text-secondary);font-size:13px}
.location-button{display:flex;align-items:center;justify-content:center;gap:8rpx;flex:none;padding:12rpx 0 12rpx 8rpx;margin:0;background:transparent;color:#333;font-size:13px;line-height:1.5;border-radius:0}
.location-button::after,.clear-button::after,.save-button::after{border:0}
.location-button[disabled]{background:transparent;color:var(--color-text-secondary)}
.location-pin{position:relative;width:18rpx;height:18rpx;border:3rpx solid currentColor;border-radius:50% 50% 50% 0;transform:rotate(-45deg);margin-right:2rpx}
.location-pin::after{content:'';position:absolute;width:5rpx;height:5rpx;border:2rpx solid currentColor;border-radius:50%;top:4rpx;left:4rpx}
.clear-button{flex:none;width:32rpx;height:32rpx;padding:0;margin:0;background:#d9d9d9;color:var(--color-on-primary);font-size:15px;line-height:29rpx;border-radius:50%}
.notice{margin-top:4rpx;padding:8rpx 20rpx;background:var(--color-primary-soft);border-radius:18rpx;color:var(--color-primary);font-size:12px;line-height:1.5}
.default-row{display:flex;align-items:center;justify-content:space-between;margin:20rpx 8rpx;color:var(--color-text-secondary);font-size:12.5px}
.default-row switch{transform:scale(.8);transform-origin:right center}
.save-button{height:80rpx;line-height:80rpx;border-radius:44rpx;background:var(--color-primary);color:var(--color-on-primary);font-size:15px;font-weight:600;margin:20rpx 0 0}
.save-button[disabled]{background:var(--color-primary-disabled);color:var(--color-on-primary)}
.loading{padding:40rpx;text-align:center;color:var(--color-text-secondary)}
.privacy-mask{position:fixed;inset:0;z-index:1000;background:rgba(16,24,40,.5);display:flex;align-items:center;justify-content:center;padding:48rpx}
.privacy-dialog{width:100%;box-sizing:border-box;background:var(--color-surface);border-radius:28rpx;padding:36rpx}
.privacy-title{font-size:17px;font-weight:600;text-align:center;margin-bottom:24rpx}
.privacy-content{font-size:14px;line-height:1.8;color:var(--color-text-secondary)}
.privacy-link{color:var(--color-primary)}
.privacy-actions{display:flex;gap:16rpx;margin-top:32rpx}
.privacy-actions button{flex:1;min-width:0;font-size:13px;padding:0 8rpx;margin:0;border-radius:12rpx}
.privacy-cancel{color:var(--color-text-secondary);background:var(--color-page)}
.privacy-confirm{background:var(--color-primary)!important}
.form-row{min-height:48px}
.label{width:86px}
.save-button{width:100%;height:44px;line-height:44px;font-size:15px}
