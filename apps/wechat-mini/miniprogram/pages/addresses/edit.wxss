.page{min-height:100vh;background:#f5f7fa;padding:0 24rpx 60rpx;box-sizing:border-box}.privacy-tip{margin:0 -24rpx 24rpx;padding:22rpx 30rpx;background:#fff3df;color:#ad7a2a;font-size:26rpx}.form-card{background:#fff;border-radius:24rpx;padding:18rpx 28rpx 24rpx}.import-actions{display:flex;gap:18rpx;padding:4rpx 0 18rpx;border-bottom:1rpx solid #f0f2f5}.import-actions button{flex:1;margin:0;color:#1677ff;background:#edf5ff;border-radius:30rpx;font-size:24rpx}.form-row{display:flex;align-items:center;min-height:96rpx;border-bottom:1rpx solid #f0f2f5}.form-row:last-of-type{border-bottom:0}.label{width:190rpx;flex:none;color:#101828;font-size:29rpx;font-weight:600}.field{flex:1;color:#344054;font-size:29rpx;text-align:right}.notice{margin-top:12rpx;padding:10rpx 18rpx;background:#edf5ff;border-radius:20rpx;color:#5b9bea;font-size:23rpx}.default-row{display:flex;align-items:center;margin:26rpx 10rpx;color:#667085;font-size:27rpx}.default-row checkbox{transform:scale(.78);margin-right:8rpx}.save-button{height:88rpx;line-height:88rpx;border-radius:44rpx;background:#1677ff;color:#fff;font-size:31rpx;margin:20rpx 0 0}
