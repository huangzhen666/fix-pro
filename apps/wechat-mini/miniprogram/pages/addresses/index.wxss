.page{min-height:100vh;background:#f5f7fa;padding:28rpx 24rpx 150rpx;box-sizing:border-box}.page-title{font-size:38rpx;font-weight:800;color:#101828;margin:10rpx 8rpx 26rpx}.address-card{background:#fff;border-radius:24rpx;padding:28rpx 30rpx;margin-bottom:20rpx;box-shadow:0 4rpx 18rpx rgba(16,24,40,.04)}.city{font-size:27rpx;color:#667085;margin-bottom:8rpx}.full-address{font-size:31rpx;color:#101828;font-weight:700;line-height:1.45;word-break:break-all}.contact{font-size:27rpx;color:#475467;margin-top:12rpx}.address-divider{height:1rpx;background:#eaecf0;margin:24rpx 0 18rpx}.address-footer{display:flex;align-items:center;justify-content:space-between;color:#98a2b3;font-size:26rpx}.default-label{color:#98a2b3}.default-dot{display:inline-flex;width:34rpx;height:34rpx;border-radius:50%;background:#2f80ed;color:#fff;align-items:center;justify-content:center;margin-right:8rpx}.default-action{color:#1677ff}.footer-actions{display:flex;gap:28rpx}.footer-actions view{color:#667085}.empty{text-align:center;padding:220rpx 0;color:#98a2b3;font-size:28rpx}.bottom-space{height:20rpx}.add-bar{position:fixed;left:0;right:0;bottom:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #eaecf0}.add-bar button{height:88rpx;line-height:88rpx;border-radius:44rpx;background:#1677ff;color:#fff;font-size:31rpx;margin:0}
