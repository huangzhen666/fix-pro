.page{min-height:100vh;background:var(--color-page);padding:28rpx 24rpx 150rpx;box-sizing:border-box}.page-title{font-size:19px;font-weight:600;color:var(--color-text);margin:10rpx 8rpx 26rpx}.address-card{background:var(--color-surface);border-radius:24rpx;padding:28rpx 30rpx;margin-bottom:20rpx;box-shadow:0 4rpx 18rpx rgba(16,24,40,.04)}.city{font-size:13.5px;color:var(--color-text-secondary);margin-bottom:8rpx}.full-address{font-size:15.5px;color:var(--color-text);font-weight:600;line-height:1.45;word-break:break-all}.contact{font-size:13.5px;color:var(--color-text-secondary);margin-top:12rpx}.address-divider{height:1rpx;background:var(--color-border);margin:24rpx 0 18rpx}.address-footer{display:flex;align-items:center;justify-content:space-between;color:var(--color-text-secondary);font-size:13px}.default-label{color:var(--color-text-secondary)}.default-dot{display:inline-flex;width:34rpx;height:34rpx;border-radius:50%;background:var(--color-primary);color:var(--color-on-primary);align-items:center;justify-content:center;margin-right:8rpx}.default-action{color:var(--color-primary)}.footer-actions{display:flex;gap:28rpx}.footer-actions view{color:var(--color-text-secondary)}.empty{text-align:center;padding:220rpx 0;color:var(--color-text-secondary);font-size:14px}.bottom-space{height:20rpx}.add-bar{position:fixed;left:0;right:0;bottom:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:var(--color-surface);border-top:1rpx solid var(--color-border)}.add-bar button{height:88rpx;line-height:88rpx;border-radius:44rpx;background:var(--color-primary);color:var(--color-on-primary);font-size:15.5px;margin:0}
.add-bar button{width:100%;height:44px;line-height:44px;font-size:15px}
