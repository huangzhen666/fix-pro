<block wx:if="{{sessionReady}}"><view class="page" wx:if="{{order}}">
  <view class="card order-card">
    <view class="order-header">
      <text class="order-no">订单号 {{order.orderNo}}</text>
      <text class="order-status">{{order.stageLabel}}</text>
    </view>
    <view class="amount-row"><text>订单金额</text><text class="amount">¥{{order.totalAmountText}}</text></view>
    <view wx:if="{{payment}}" class="info-row"><text class="info-label">付款状态</text><text class="info-value">{{paymentLabel}} {{payment.payments[0].channel === 'MOCK' ? '（模拟支付，无真实扣款）' : ''}}</text></view>
    <view wx:if="{{payment.expiresAt && payment.status === 'UNPAID'}}" class="muted">支付截止 {{payment.expiresAt}}</view>
    <button wx:if="{{payment.required && payment.status === 'UNPAID' && order.status === 'PENDING_CONFIRMATION'}}" type="primary" loading="{{paying}}" disabled="{{paying}}" bindtap="pay">立即支付 ¥{{order.totalAmountText}}</button>
    <view class="info-row"><text class="info-label">下单时间</text><text class="info-value">{{order.createdAtText}}</text></view>
    <view class="info-section-title">上门信息</view>
    <view class="info-row"><text class="info-label">联系人</text><text class="info-value">{{order.contactName}} {{order.contactMobile}}</text></view>
    <view class="info-row address"><text class="info-label">服务地址</text><text class="info-value">{{order.serviceAddress}}</text></view>
    <view class="info-row"><text class="info-label">预约时间</text><text class="info-value">{{order.appointmentText}}</text></view>
    <view wx:if="{{order.cancelReason}}" class="cancel-reason">取消说明：{{order.cancelReason}}</view>
    <button wx:if="{{order.status === 'CANCELLED' && order.cancelReason}}" class="reorder-button" loading="{{reordering}}" disabled="{{reordering}}" bindtap="reorder">重新下单</button>
  </view>

  <view class="card demand-card"><view class="demand-head"><text class="section-title">备注</text><button wx:if="{{demand.editable || demandLoadError}}" class="edit-demand" bindtap="openDemand" loading="{{demandLoading}}">{{demandLoadError ? '重新加载' : '补充／修改备注'}}</button></view>
    <view wx:if="{{demandLoadError}}" class="muted">{{demandLoadError}}</view>
    <block wx:else><view wx:for="{{demand.items}}" wx:key="itemId" class="demand-summary"><view wx:if="{{demand.items.length > 1}}" class="demand-name">{{item.name}}</view><text class="demand-text">{{item.demandDescription || (item.demandMedia.length ? '' : '暂无备注')}} </text><view class="demand-files"><view wx:for="{{item.demandMedia}}" wx:for-item="media" wx:key="id" data-item="{{item.itemId}}" data-media="{{media.id}}" bindtap="previewDemand">{{media.mediaType === 'VIDEO' ? '▶ 视频' : '查看图片'}}</view></view></view><view wx:if="{{demand.editable}}" class="muted">可补充现场情况或图片</view></block>
  </view>

  <view class="card" wx:for="{{order.items}}" wx:key="id"><view class="section-title">{{item.name}} × {{item.quantity}}{{item.unit}}</view><view class="muted">{{item.demandDescription}}</view><service-content description="{{item.serviceDescription}}" notice="{{item.serviceNotice}}"/></view>
  <view wx:for="{{order.workOrders}}" wx:key="id" class="card fulfillment-card">
    <view class="section-header"><text class="section-title">履约详情</text><text class="work-order-no">{{item.workOrderNo}}</text></view>
    <view class="steps">
      <view wx:for="{{item.flowSteps}}" wx:for-item="step" wx:key="key" class="step {{step.state}}">
        <view class="step-track"><view class="step-dot"><text>{{step.index}}</text></view><view wx:if="{{!step.last}}" class="step-line"></view></view>
        <text class="step-label">{{step.label}}</text>
      </view>
    </view>

    <view class="timeline">
      <view wx:for="{{item.timelineSteps}}" wx:for-item="step" wx:key="key" class="timeline-item {{step.state}}">
        <view class="timeline-axis"><view class="timeline-dot"></view><view wx:if="{{!step.last}}" class="timeline-line"></view></view>
        <view class="timeline-content">
          <view class="timeline-head"><text class="timeline-title">{{step.label}}</text><text wx:if="{{step.timeText}}" class="timeline-time">{{step.timeText}}</text></view>
          <view class="timeline-description">{{step.description}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{item.assigneeName || item.appointmentText}}" class="service-info">
      <view wx:if="{{item.assigneeName}}" class="info-row"><text class="info-label">服务师傅</text><text class="info-value">{{item.assigneeName}}</text></view>
      <view wx:if="{{item.appointmentText}}" class="info-row"><text class="info-label">预约时间</text><text class="info-value">{{item.appointmentText}}</text></view>
    </view>
    <view wx:if="{{item.completionSummary}}" class="completion-summary">服务说明：{{item.completionSummary}}</view>
    <view class="evidence"><view wx:for="{{item.evidence}}" wx:key="id" class="evidence-item"><text>{{item.label}}</text><image src="{{item.url}}" mode="aspectFill" /></view></view>
    <view wx:if="{{(item.status === 'WAITING_ACCEPTANCE' || item.status === 'WAITING_QA_AUDIT' || item.status === 'WAITING_DIRECTOR_AUDIT') && (!item.customerAcceptanceStatus || item.customerAcceptanceStatus === 'PENDING')}}" class="actions"><button size="mini" type="primary" loading="{{acceptingWorkOrderId === item.id}}" disabled="{{acceptingWorkOrderId === item.id}}" data-work-id="{{item.id}}" data-decision="ACCEPT" bindtap="acceptance">确认完成</button><button size="mini" loading="{{acceptingWorkOrderId === item.id}}" disabled="{{acceptingWorkOrderId === item.id}}" data-work-id="{{item.id}}" data-decision="REJECT" bindtap="acceptance">需要返工</button></view>
    <button wx:if="{{item.status === 'FINISHED' || item.status === 'FINISHED_WITH_REVIEW_EXCEPTION'}}" size="mini" data-work-id="{{item.id}}" bindtap="rating">评价服务</button>
  </view>
</view>
<view wx:if="{{!loading && !order}}" class="empty">订单不存在或暂时无法加载</view>
</block><view wx:else style="padding:40rpx;text-align:center;color:#888">正在校验登录状态，请保持网络连接</view>
<demand-editor open="{{showDemandEditor && (sessionReady || demandUploading)}}" items="{{editorItems}}" saving="{{demandSaving}}" error="{{demandSaveError}}" conflict="{{demandConflict}}" previous-items="{{previousDemand}}" bind:change="demandChange" bind:busy="demandBusy" bind:close="closeDemand" bind:save="saveOrderDemand" bind:refresh="refreshDemand"/>
