.page{padding:24rpx;background:var(--color-page);min-height:100vh}.card{background:var(--color-surface);border-radius:20rpx;padding:28rpx;margin-bottom:20rpx}.order:active{background:var(--color-primary-soft)}.row{display:flex;justify-content:space-between;align-items:center}.title{font-size:15px;font-weight:600}.status{font-size:12px;color:var(--color-primary)}.muted{color:var(--color-text-secondary);font-size:12px;margin-top:12rpx}.cancel-reason{margin-top:18rpx;padding:16rpx 18rpx;background:var(--color-danger-soft);border-radius:10rpx;color:var(--color-danger);font-size:12px;line-height:1.5}.summary{margin-top:24rpx;color:var(--color-text-secondary);font-size:12.5px}.amount{color:var(--color-text);font-weight:600}.empty{text-align:center;color:var(--color-text-secondary);margin-top:80rpx}
