.page{padding:24rpx;background:#f5f7fa;min-height:100vh;box-sizing:border-box;padding-bottom:48rpx}.card{background:#fff;border-radius:20rpx;padding:28rpx;margin-bottom:20rpx;box-sizing:border-box}.order-card{padding-bottom:22rpx}.order-header,.amount-row,.info-row,.timeline-head{display:flex;align-items:center;justify-content:space-between}.order-header{padding-bottom:24rpx;border-bottom:1rpx solid #f0f2f5}.order-no{color:#101828;font-size:28rpx;font-weight:600}.order-status{color:#1677ff;font-size:24rpx}.amount-row{padding:24rpx 0;color:#667085;font-size:26rpx}.amount{color:#101828;font-size:36rpx;font-weight:700}.info-section-title{margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid #f0f2f5;color:#101828;font-size:29rpx;font-weight:700}.info-row{align-items:flex-start;margin-top:16rpx;color:#667085;font-size:25rpx;line-height:1.5}.info-label{width:140rpx;flex:none;color:#98a2b3}.info-value{flex:1;color:#344054;text-align:right;word-break:break-all}.address .info-value{text-align:left}.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28rpx}.section-title{font-size:32rpx;color:#101828;font-weight:700}.work-order-no{color:#98a2b3;font-size:23rpx}.steps{display:flex;padding:0 4rpx 28rpx}.step{flex:1;min-width:0;text-align:center;color:#98a2b3;font-size:23rpx}.step-track{height:44rpx;position:relative}.step-dot{position:absolute;left:50%;top:0;transform:translateX(-50%);width:40rpx;height:40rpx;border-radius:50%;background:#e4e7ec;color:#fff;font-size:22rpx;line-height:40rpx;z-index:1}.step-line{position:absolute;left:calc(50% + 24rpx);top:19rpx;width:calc(50% - 24rpx);height:2rpx;background:#e4e7ec}.step-label{display:block;margin-top:12rpx;white-space:nowrap}.step.done .step-dot{background:#b8c0cc}.step.done .step-line{background:#b8c0cc}.step.current{color:#1677ff;font-weight:600}.step.current .step-dot{background:#1677ff;box-shadow:0 0 0 8rpx #e8f1ff}.step.current .step-line{background:#b8c0cc}.timeline{padding-top:4rpx}.timeline-item{display:flex;min-height:104rpx}.timeline-axis{width:36rpx;flex:none;position:relative}.timeline-dot{position:absolute;left:7rpx;top:7rpx;width:20rpx;height:20rpx;border-radius:50%;background:#d0d5dd;box-shadow:0 0 0 6rpx #f2f4f7}.timeline-line{position:absolute;left:16rpx;top:31rpx;bottom:-4rpx;width:2rpx;background:#eaecf0}.timeline-content{flex:1;padding:0 0 28rpx 18rpx}.timeline-head{justify-content:flex-start;gap:18rpx}.timeline-title{font-size:29rpx;color:#344054}.timeline-time{font-size:23rpx;color:#98a2b3}.timeline-description{margin-top:8rpx;color:#98a2b3;font-size:24rpx;line-height:1.55}.timeline-item.current .timeline-dot{background:#1677ff;box-shadow:0 0 0 6rpx #e8f1ff}.timeline-item.current .timeline-title{color:#1677ff;font-weight:600}.timeline-item.current .timeline-description{color:#667085}.service-info{margin-top:4rpx;padding-top:20rpx;border-top:1rpx solid #f0f2f5}.completion-summary{margin-top:20rpx;padding:20rpx;background:#f8fafc;border-radius:12rpx;color:#667085;font-size:24rpx;line-height:1.6}.evidence{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:20rpx}.evidence image{width:190rpx;height:190rpx;border-radius:12rpx;background:#f2f4f7}.actions{display:flex;gap:20rpx;margin-top:24rpx}.actions button{margin:0;flex:1}.fulfillment-card>button{margin-top:24rpx}.empty{text-align:center;padding-top:180rpx;color:#98a2b3;font-size:26rpx}
