.page{padding:24rpx;background:var(--color-page);min-height:100vh;box-sizing:border-box;padding-bottom:48rpx}.card{background:var(--color-surface);border-radius:20rpx;padding:28rpx;margin-bottom:20rpx;box-sizing:border-box}.order-card{padding-bottom:22rpx}.order-header,.amount-row,.info-row,.timeline-head{display:flex;align-items:center;justify-content:space-between}.order-header{padding-bottom:24rpx;border-bottom:1rpx solid var(--color-border)}.order-no{color:var(--color-text);font-size:14px;font-weight:600}.order-status{color:var(--color-primary);font-size:12px}.amount-row{padding:24rpx 0;color:var(--color-text-secondary);font-size:13px}.amount{color:var(--color-text);font-size:18px;font-weight:600}.info-section-title{margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid var(--color-border);color:var(--color-text);font-size:14.5px;font-weight:600}.info-row{align-items:flex-start;margin-top:16rpx;color:var(--color-text-secondary);font-size:12.5px;line-height:1.5}.info-label{width:140rpx;flex:none;color:var(--color-text-secondary)}.info-value{flex:1;color:var(--color-text);text-align:right;word-break:break-all}.address .info-value{text-align:left}.cancel-reason{margin-top:20rpx;padding:18rpx;background:var(--color-danger-soft);border-radius:10rpx;color:var(--color-danger);font-size:12px;line-height:1.5}.reorder-button{margin:20rpx 0 0;width:100%;height:76rpx;line-height:76rpx;border-radius:38rpx;color:var(--color-primary);background:var(--color-surface);border:2rpx solid var(--color-primary)}.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28rpx}.section-title{font-size:16px;color:var(--color-text);font-weight:600}.work-order-no{color:var(--color-text-secondary);font-size:12px}.steps{display:flex;padding:0 4rpx 28rpx}.step{flex:1;min-width:0;text-align:center;color:var(--color-text-secondary);font-size:12px}.step-track{height:44rpx;position:relative}.step-dot{position:absolute;left:50%;top:0;transform:translateX(-50%);width:40rpx;height:40rpx;border-radius:50%;background:#e4e7ec;color:var(--color-on-primary);font-size:12px;line-height:40rpx;z-index:1}.step-line{position:absolute;left:calc(50% + 24rpx);top:19rpx;width:calc(50% - 24rpx);height:2rpx;background:#e4e7ec}.step-label{display:block;margin-top:12rpx;white-space:nowrap}.step.done .step-dot{background:#b8c0cc}.step.done .step-line{background:#b8c0cc}.step.current{color:var(--color-primary);font-weight:600}.step.current .step-dot{background:var(--color-primary);box-shadow:0 0 0 8rpx var(--color-primary-soft)}.step.current .step-line{background:#b8c0cc}.timeline{padding-top:4rpx}.timeline-item{display:flex;min-height:104rpx}.timeline-axis{width:36rpx;flex:none;position:relative}.timeline-dot{position:absolute;left:7rpx;top:7rpx;width:20rpx;height:20rpx;border-radius:50%;background:#d0d5dd;box-shadow:0 0 0 6rpx var(--color-page)}.timeline-line{position:absolute;left:16rpx;top:31rpx;bottom:-4rpx;width:2rpx;background:var(--color-border)}.timeline-content{flex:1;padding:0 0 28rpx 18rpx}.timeline-head{justify-content:flex-start;gap:18rpx}.timeline-title{font-size:14.5px;color:var(--color-text)}.timeline-time{font-size:12px;color:var(--color-text-secondary)}.timeline-description{margin-top:8rpx;color:var(--color-text-secondary);font-size:12px;line-height:1.55}.timeline-item.current .timeline-dot{background:var(--color-primary);box-shadow:0 0 0 6rpx var(--color-primary-soft)}.timeline-item.current .timeline-title{color:var(--color-primary);font-weight:600}.timeline-item.current .timeline-description{color:var(--color-text-secondary)}.service-info{margin-top:4rpx;padding-top:20rpx;border-top:1rpx solid var(--color-border)}.completion-summary{margin-top:20rpx;padding:20rpx;background:var(--color-primary-soft);border-radius:12rpx;color:var(--color-text-secondary);font-size:12px;line-height:1.6}.evidence{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:20rpx}.evidence image{width:190rpx;height:190rpx;border-radius:12rpx;background:var(--color-page)}.actions{display:flex;gap:20rpx;margin-top:24rpx}.actions button{margin:0;flex:1}.fulfillment-card>button{margin-top:24rpx}.empty{text-align:center;padding-top:180rpx;color:var(--color-text-secondary);font-size:13px}
.step-dot{color:var(--color-text-secondary)}
.step.done .step-dot{background:var(--color-primary-soft);color:var(--color-primary)}
