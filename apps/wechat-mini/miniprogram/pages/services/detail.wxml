<view class="page"><view wx:if="{{loading}}" class="card muted">加载中…</view><view wx:elif="{{error}}" class="card">{{error}}</view><block wx:else><swiper class="gallery" indicator-dots autoplay><swiper-item wx:for="{{service.galleryImageUrls}}" wx:key="*this"><image src="{{item}}" mode="aspectFill"/></swiper-item></swiper><view class="card"><view class="title">{{service.name}}</view><view class="price">¥{{service.priceText}}<text>/{{service.unit}}</text></view><view class="muted">{{service.description}}</view></view><view class="card"><view class="section-title">服务范围</view><view>{{service.serviceScope}}</view><view class="section-title gap">除外项</view><view>{{service.exclusions}}</view><view class="section-title gap">售后/质保说明</view><view>{{service.warrantyDescription}}</view></view><view class="bottom"><view class="counter"><button size="mini" data-delta="-1" bindtap="changeQuantity">−</button><text>{{quantity}}</text><button size="mini" data-delta="1" bindtap="changeQuantity">+</button></view><button class="primary" loading="{{adding}}" bindtap="add">加入购物车</button></view></block></view>
