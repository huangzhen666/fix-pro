<view class="page"><view wx:if="{{loading}}" class="card muted">加载中…</view><view wx:elif="{{error}}" class="card">{{error}}</view><block wx:else><swiper class="gallery" indicator-dots autoplay><swiper-item wx:for="{{service.galleryImageUrls}}" wx:key="*this"><image wx:if="{{!galleryErrors[index]}}" src="{{item}}" mode="aspectFill" data-index="{{index}}" binderror="galleryError"/><view wx:else class="gallery-fallback"><image src="/assets/icons/service-service.svg"/><text>图片暂时无法显示</text></view></swiper-item></swiper><view class="card"><view class="title">{{service.name}}</view><view class="price">¥{{service.priceText}}<text>/{{service.unit}}</text></view><view class="muted">{{service.description}}</view><view class="muted">{{service.detailProfile.billing.unitDefinition}}</view><view class="muted">{{service.detailProfile.billing.feeDescription}}</view><view class="quantity-row"><text>服务数量</text><view class="counter"><button data-delta="-1" bindtap="changeQuantity" disabled="{{quantity <= service.detailProfile.billing.quantity.min || adding || ordering}}">−</button><text>{{quantity}}</text><button data-delta="1" bindtap="changeQuantity" disabled="{{quantity + service.detailProfile.billing.quantity.step > service.detailProfile.billing.quantity.max || adding || ordering}}">+</button></view></view><view class="detail-subtotal">小计 <text>¥{{subtotalText}}</text></view></view><service-profile profile="{{service.detailProfile}}"/><view class="bottom">
  <view class="cart-entry" bindtap="openCart" role="button" aria-label="查看购物车">
    <view class="cart-icon"><image class="cart-icon-image" src="/assets/icons/cart.svg" mode="aspectFit"/><text wx:if="{{cartCount}}" class="cart-badge">{{cartCount > 99 ? '99+' : cartCount}}</text></view>
    <text class="cart-label">购物车</text>
  </view>
  <button class="add-button" loading="{{adding}}" disabled="{{adding || ordering}}" bindtap="add">加入购物车</button>
  <button class="order-button" loading="{{ordering}}" disabled="{{adding || ordering}}" bindtap="orderNow">立即下单</button>
</view></block></view>
