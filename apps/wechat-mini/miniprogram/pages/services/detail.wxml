<view class="page"><view wx:if="{{loading}}" class="card muted">加载中…</view><view wx:elif="{{error}}" class="card">{{error}}</view><block wx:else><swiper class="gallery" indicator-dots autoplay><swiper-item wx:for="{{service.galleryImageUrls}}" wx:key="*this"><image src="{{item}}" mode="aspectFill"/></swiper-item></swiper><view class="card"><view class="title">{{service.name}}</view><view class="price">¥{{service.priceText}}<text>/{{service.unit}}</text></view><view class="muted">{{service.description}}</view><view class="quantity-row"><text>服务数量</text><view class="counter"><button data-delta="-1" bindtap="changeQuantity" disabled="{{quantity <= 1 || adding || ordering}}">−</button><text>{{quantity}}</text><button data-delta="1" bindtap="changeQuantity" disabled="{{quantity >= 99 || adding || ordering}}">+</button></view></view></view><view class="card"><view class="section-title">服务范围</view><view>{{service.serviceScope}}</view><view class="section-title gap">除外项</view><view>{{service.exclusions}}</view><view class="section-title gap">售后/质保说明</view><view>{{service.warrantyDescription}}</view></view><view class="bottom">
  <view class="cart-entry" bindtap="openCart" role="button" aria-label="查看购物车"><view class="cart-icon">🛒<text wx:if="{{cartCount}}" class="cart-badge">{{cartCount > 99 ? '99+' : cartCount}}</text></view><text>购物车</text></view>
  <button class="add-button" loading="{{adding}}" disabled="{{adding || ordering}}" bindtap="add">加入购物车</button>
  <button class="order-button" loading="{{ordering}}" disabled="{{adding || ordering}}" bindtap="orderNow">立即下单</button>
</view></block></view>
