<view class="catalog-page">
  <view class="catalog-header"><view class="search" bindtap="openSearch" role="button" aria-label="搜索维修服务"><image src="/assets/icons/search.svg" mode="aspectFit"/><text>搜索维修服务</text></view></view>
  <view wx:if="{{loading}}" class="loading">正在加载服务…</view>
  <view wx:elif="{{error}}" class="error"><view>服务加载失败，请稍后重试</view><button class="retry-button" bindtap="load">重新加载</button></view>
  <view wx:else class="catalog-body">
    <scroll-view scroll-y class="category-nav"><view class="category-item {{activeId===item.id?'active':''}}" wx:for="{{groups}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</view></scroll-view>
    <scroll-view scroll-y class="service-area"><view class="group-title">{{activeName || '全部服务'}}</view><view class="service-grid"><view class="service" wx:for="{{services}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail"><image src="{{item.coverImageUrl}}" mode="aspectFill"/><view class="service-copy"><view class="service-name">{{item.name}}</view><view class="price">¥{{item.priceText}}<text>/{{item.unit}}</text></view></view></view></view><view wx:if="{{!services.length}}" class="empty">该分类暂时没有服务，试试其他分类吧</view><view class="list-bottom"/></scroll-view>
  </view>
  <view class="cart-float" bindtap="openCart" role="button" aria-label="查看购物车"><image src="/assets/icons/cart.svg" mode="aspectFit"/><text>购物车</text><text wx:if="{{cartCount}}" class="cart-count">{{cartCount > 99 ? '99+' : cartCount}}</text></view>
</view>
