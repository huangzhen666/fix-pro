<view class="catalog-page"><view class="catalog-header"><view class="title">全部服务</view><view class="search" bindtap="openSearch">⌕ <text>搜索维修服务</text></view></view><view wx:if="{{loading}}" class="loading">正在加载服务目录…</view><view wx:elif="{{error}}" class="error">{{error}}</view><view wx:else class="catalog-body"><scroll-view scroll-y class="category-nav"><view class="category-item {{activeId===item.id?'active':''}}" wx:for="{{groups}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</view></scroll-view><scroll-view scroll-y class="service-area"><view class="group-title">{{activeName}}</view><view class="service-grid"><view class="service" wx:for="{{services}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail"><image src="{{item.coverImageUrl}}" mode="aspectFill"/><view class="service-name">{{item.name}}</view><view class="price">¥{{item.priceText}}<text>/{{item.unit}}</text></view></view></view><view wx:if="{{!services.length}}" class="empty">该分类暂未发布服务</view></scroll-view></view><view class="cart-float" bindtap="openCart">🛒<text wx:if="{{cartCount}}">{{cartCount}}</text></view></view>
