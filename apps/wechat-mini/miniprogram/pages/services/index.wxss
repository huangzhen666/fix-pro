.catalog-page{height:100vh;display:flex;flex-direction:column;background:#fff}.catalog-header{padding:26rpx 28rpx 24rpx;background:linear-gradient(180deg,#eaf2ff,#f8faff)}.title{text-align:center;font-size:38rpx;font-weight:800;margin-bottom:24rpx}.search{height:78rpx;background:#fff;border-radius:40rpx;display:flex;align-items:center;padding:0 26rpx;font-size:38rpx;color:#1f2937}.search text{font-size:26rpx;color:#98a2b3;margin-left:14rpx}.catalog-body{display:flex;flex:1;min-height:0}.category-nav{width:190rpx;height:100%;background:#f5f6f8}.category-item{padding:34rpx 20rpx;font-size:26rpx;color:#667085;position:relative}.category-item.active{background:#fff;color:#1677ff;font-weight:700}.category-item.active:before{content:'';position:absolute;left:0;top:28rpx;width:7rpx;height:38rpx;border-radius:0 8rpx 8rpx 0;background:#1677ff}.service-area{flex:1;height:100%;padding:24rpx;box-sizing:border-box}.group-title{font-size:32rpx;font-weight:800;padding:8rpx 0 24rpx}.service-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:28rpx 18rpx}.service{text-align:center;min-width:0}.service image{width:100%;height:180rpx;border-radius:14rpx;background:#f4f6f8}.service-name{font-size:26rpx;font-weight:700;margin-top:12rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.price{font-size:26rpx;color:#e5484d;font-weight:700;margin-top:6rpx}.price text{font-size:19rpx;color:#98a2b3;font-weight:400}.empty,.loading,.error{padding:100rpx 30rpx;text-align:center;color:#667085}.cart-float{position:fixed;right:26rpx;bottom:145rpx;width:88rpx;height:88rpx;border-radius:50%;background:#1677ff;color:#fff;display:flex;align-items:center;justify-content:center;font-size:38rpx;box-shadow:0 10rpx 28rpx rgba(22,119,255,.35)}.cart-float text{position:absolute;right:-4rpx;top:-7rpx;background:#e5484d;border-radius:18rpx;min-width:30rpx;height:30rpx;line-height:30rpx;text-align:center;font-size:19rpx}
