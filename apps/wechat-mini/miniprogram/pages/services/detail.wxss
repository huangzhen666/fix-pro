.page{padding-bottom:calc(160rpx + env(safe-area-inset-bottom))}.gallery{height:520rpx;background:#eef2f6}.gallery image{width:100%;height:100%}.title{font-size:40rpx;font-weight:700}.price{font-size:40rpx;color:#e5484d;font-weight:700;margin:16rpx 0}.price text{font-size:24rpx;color:#667085;font-weight:400}.gap{margin-top:28rpx}
.quantity-row{display:flex;justify-content:space-between;align-items:center;margin-top:24rpx;font-size:28rpx}.counter{display:flex;align-items:center;border:1rpx solid #eaecf0;border-radius:28rpx;overflow:hidden}.counter button{width:60rpx;height:52rpx;line-height:50rpx;padding:0;margin:0;background:#fff;color:#344054;font-size:30rpx;border-radius:0}.counter button::after{border:0}.counter button[disabled]{color:#d0d5dd}.counter text{width:50rpx;text-align:center;font-size:26rpx}
.bottom{position:fixed;bottom:0;left:0;right:0;z-index:20;background:white;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:16rpx;border-top:1rpx solid #eee}.cart-entry{flex:none;width:100rpx;text-align:center;font-size:23rpx;color:#344054}.cart-icon{position:relative;display:inline-block;font-size:40rpx;line-height:48rpx}.cart-badge{position:absolute;right:-22rpx;top:-8rpx;min-width:26rpx;padding:0 6rpx;height:30rpx;line-height:30rpx;border-radius:16rpx;background:#ff7043;color:#fff;font-size:20rpx}.bottom button{flex:1;min-width:0;padding:0;margin:0;height:80rpx;line-height:80rpx;border-radius:40rpx;font-size:28rpx;font-weight:600}.bottom button::after{border:0}.add-button{background:#e8f2ff;color:#1677ff}.order-button{background:#1677ff;color:#fff}.bottom button[disabled]{opacity:.6}
