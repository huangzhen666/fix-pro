<view class="page"><view class="card"><view class="section-title">服务信息</view><view class="line" wx:for="{{cart.items}}" wx:key="id"><view><view>{{item.name}} × {{item.quantity}}{{item.unit}}</view><view class="muted">{{item.faultDescription}}</view></view><view>¥{{item.subtotal/100}}</view></view></view><view class="card"><view class="section-title">上门信息</view><input placeholder="联系人（2-64字）" data-field="contactName" bindinput="input"/><input type="number" maxlength="11" placeholder="手机号" data-field="contactMobile" bindinput="input"/><textarea placeholder="详细服务地址" data-field="serviceAddress" bindinput="input"/><view class="section-title">客户预约时间段</view><picker mode="date" value="{{appointmentDate}}" start="{{appointmentDate}}" bindchange="chooseDate"><view class="picker-value">日期：{{appointmentDate}}</view></picker><picker mode="selector" range="{{slots}}" bindchange="chooseSlot"><view class="picker-value">时间段：{{appointmentSlot || '请选择'}}（每2小时）</view></picker></view><view class="submit-bar"><view>合计 <text>¥{{totalText}}</text></view><button type="primary" loading="{{submitting}}" bindtap="submit">提交订单</button></view></view>
