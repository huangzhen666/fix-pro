<block wx:if="{{sessionReady}}">
  <view class="page checkout-page">
    <view wx:if="{{loading}}" class="state">正在加载订单信息…</view>
    <view wx:elif="{{loadError}}" class="state"><text>{{loadError}}</text><view class="state-actions"><button bindtap="retryLoad">重新加载</button><button bindtap="back">返回选择</button></view></view>
    <block wx:else>
      <view class="card visit-card">
        <view id="service-address" class="address-selector" bindtap="openAddressPicker" role="button" aria-label="选择服务地址">
          <image class="address-icon" src="/assets/icons/map-pin.svg" mode="aspectFit"/>
          <view class="address-content" wx:if="{{selectedAddress}}"><view class="address-detail">{{selectedAddress.detailAddress}}{{selectedAddress.buildingDoor}}</view><view class="address-contact">{{selectedAddress.city}} · {{selectedAddress.contactName}}　{{selectedAddress.contactMobile}}</view></view>
          <view class="address-content" wx:else><view class="address-empty">添加服务地址</view><view class="address-contact">请先填写上门服务地址</view></view>
          <text class="chevron">›</text>
        </view>
        <view wx:if="{{addressError}}" class="field-error">{{addressError}}</view>
        <view id="appointment" class="appointment-trigger" bindtap="openAppointmentPicker"><text class="field-label">预约上门时间</text><view class="appointment-value {{appointmentSlot ? 'chosen' : ''}}">{{appointmentDisplayText}}</view><text class="chevron">›</text></view>
        <view wx:if="{{appointmentError}}" class="field-error">{{appointmentError}}</view>
      </view>
      <view class="card service-card"><view class="card-title">服务清单</view>
        <view wx:for="{{services}}" wx:key="id" class="service-row">
          <image wx:if="{{!item.imageFailed}}" class="cover" src="{{item.coverImageUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="coverError"/>
          <view wx:else class="cover cover-fallback"><image src="/assets/icons/wrench.svg" mode="aspectFit"/></view>
          <view class="service-copy"><view class="service-name">{{item.name}}</view><view class="service-price"><text class="unit-price">¥{{item.priceText}}/{{item.unit}} × {{item.quantity}}</text><text class="subtotal">¥{{item.subtotalText}}</text></view></view>
        </view>
        <view class="demand-entry" bindtap="openDemand"><text>备注</text><text class="demand-summary">{{hasDemand ? '已填写' : '选填，说明情况或服务要求'}}</text><text class="chevron">›</text></view>
      </view>
      <view wx:if="{{submissionUnknown}}" class="pending-tip">提交结果待确认，请重试以获取订单结果。</view>
      <view class="submit-bar"><view class="total">合计 <text style="font-size:{{totalText.length > 12 ? 13 : totalText.length > 9 ? 16 : 20}}px">¥{{totalText}}</text></view><button loading="{{submitting}}" disabled="{{uploading || submitting}}" bindtap="submit">{{submitting ? '正在提交…' : uploading ? '资料上传中' : submissionUnknown ? '重试提交' : '提交订单'}}</button></view>
    </block>
    <view wx:if="{{showAppointmentPicker}}" class="appointment-modal">
      <view class="appointment-mask" catchtap="cancelAppointmentPicker"></view>
      <view class="appointment-sheet"><view class="appointment-header"><view><view class="appointment-title">预约上门时间</view><view class="appointment-subtitle">师傅会联系您，确认最终上门时间</view></view><button class="appointment-close" bindtap="cancelAppointmentPicker" aria-label="关闭预约时间">×</button></view>
        <view class="appointment-body"><scroll-view class="appointment-dates" scroll-y><view wx:for="{{appointmentDates}}" wx:key="value" class="date-option {{item.selected ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="chooseAppointmentDate">{{item.label}}<text wx:if="{{item.selected}}"> ✓</text></view></scroll-view>
          <scroll-view class="appointment-slots" scroll-y><block wx:for="{{appointmentSlots}}" wx:key="value"><view wx:if="{{item.showPeriod}}" class="slot-period">{{item.period}}</view><view class="slot-option {{item.selected ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="chooseAppointmentSlot">{{item.label}}<text wx:if="{{item.selected}}"> ✓</text></view></block></scroll-view></view>
        <view class="appointment-actions"><button bindtap="confirmAppointmentPicker">确认时间</button></view>
      </view>
    </view>
  </view>
</block>
<view wx:else class="state">正在校验登录状态…</view>
<demand-editor open="{{showDemandEditor && (sessionReady || uploading)}}" items="{{editorItems}}" bind:change="demandChange" bind:busy="demandBusy" bind:close="closeDemand" bind:save="saveDemandDraft"/>
