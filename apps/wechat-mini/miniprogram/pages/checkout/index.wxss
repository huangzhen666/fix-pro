.page{padding-bottom:130rpx}.line{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid #eee}.line:last-child{border:0}input,textarea{width:100%;box-sizing:border-box;background:#f7f8fa;border-radius:10rpx;margin-top:18rpx;padding:20rpx}textarea{height:150rpx}.submit-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:18rpx 28rpx;border-top:1rpx solid #eee;display:flex;align-items:center;justify-content:space-between}.submit-bar text{color:#e5484d;font-size:36rpx;font-weight:700}.submit-bar button{margin:0;width:300rpx}
