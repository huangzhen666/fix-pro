.page{padding-bottom:130rpx}.line{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid var(--color-border)}.line:last-child{border:0}input,textarea{width:100%;box-sizing:border-box;background:var(--color-page);border-radius:10rpx;margin-top:18rpx;padding:20rpx}.address-selector{display:flex;align-items:center;margin-top:18rpx;padding:24rpx;background:var(--color-surface);border-radius:14rpx;border:1rpx solid var(--color-border)}.address-icon{font-size:21px;color:var(--color-primary);margin-right:18rpx}.address-content{flex:1;min-width:0}.address-title{font-size:14.5px;font-weight:600;color:var(--color-text)}.address-detail{margin-top:6rpx;color:var(--color-text);font-size:13.5px;word-break:break-all}.address-contact{margin-top:8rpx;color:var(--color-text-secondary);font-size:12px}.address-empty{color:var(--color-primary);font-size:14.5px}.address-empty view{margin-top:7rpx;color:var(--color-text-secondary);font-size:12px}.appointment-trigger{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx;padding:24rpx;background:var(--color-page);border-radius:12rpx}.appointment-trigger-title{font-weight:600}.appointment-trigger-value{color:var(--color-text-secondary);flex:1;text-align:right;margin-left:20rpx}.chevron{font-size:18px;color:var(--color-text-secondary);margin-left:12rpx}.submit-bar{position:fixed;bottom:0;left:0;right:0;background:var(--color-surface);padding:18rpx 28rpx;border-top:1rpx solid var(--color-border);display:flex;align-items:center;justify-content:space-between;z-index:10}.submit-bar text{color:var(--color-price);font-size:18px;font-weight:600}.submit-bar button{margin:0;width:300rpx}.appointment-modal{position:fixed;z-index:100;left:0;right:0;top:0;bottom:0}.appointment-mask{position:absolute;top:0;right:0;bottom:0;left:0;background:rgba(0,0,0,.48)}.appointment-sheet{position:absolute;left:0;right:0;bottom:0;height:78vh;background:var(--color-surface);border-radius:28rpx 28rpx 0 0;display:flex;flex-direction:column;overflow:hidden}.appointment-header{display:flex;justify-content:space-between;align-items:flex-start;padding:32rpx 36rpx 20rpx}.appointment-title{font-size:19px;font-weight:600;color:var(--color-text)}.appointment-subtitle{font-size:12.5px;color:var(--color-text-secondary);margin-top:12rpx}.appointment-close{font-size:24px;line-height:42rpx;color:#c4c7cc}.appointment-body{display:flex;flex:1;min-height:0}.appointment-dates{width:39%;background:var(--color-page);height:100%;box-sizing:border-box;padding:8rpx 0}.appointment-slots{width:61%;height:100%;box-sizing:border-box;padding:8rpx 28rpx 8rpx 34rpx}.date-option{padding:28rpx 20rpx;color:var(--color-text-secondary);font-size:14px;line-height:1.35;text-align:center}.date-option.selected{background:var(--color-surface);color:var(--color-text);font-weight:600}.slot-period{padding:18rpx 0 8rpx;color:var(--color-text-secondary);font-size:13px}.slot-option{padding:22rpx 0;border-bottom:1rpx solid var(--color-border);color:var(--color-text);font-size:15.5px}.slot-option.selected{color:var(--color-primary);font-weight:600}.appointment-actions{display:flex;gap:20rpx;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:var(--color-surface);border-top:1rpx solid var(--color-border)}.appointment-actions button{flex:1;margin:0;height:88rpx;line-height:88rpx;border-radius:44rpx;font-size:15.5px}.cancel-button{background:var(--color-surface);color:var(--color-primary);border:2rpx solid var(--color-primary)}.confirm-button{background:var(--color-primary);color:var(--color-on-primary);border:2rpx solid var(--color-primary)}
.page{padding-bottom:calc(100px + env(safe-area-inset-bottom))}
.line{gap:16px}.line>view:first-child{min-width:0;flex:1;word-break:break-all}.line>view:last-child{flex:none}
.submit-bar{padding:12px 16px calc(12px + env(safe-area-inset-bottom));gap:12px}
.submit-bar button{width:140px;height:44px;line-height:44px;padding:0;flex:none;font-size:15px}
.submit-bar text{font-size:19px;color:var(--color-price)}
.appointment-sheet{max-height:85vh;height:78vh;background:var(--color-surface)}
.appointment-trigger-title{flex:none}.appointment-trigger-value{word-break:break-word;font-size:13px}
.appointment-subtitle{color:var(--color-text-secondary)}
.date-option.selected{color:var(--color-primary)}
