.page{padding-bottom:130rpx}.line{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid #eee}.line:last-child{border:0}input,textarea{width:100%;box-sizing:border-box;background:#f7f8fa;border-radius:10rpx;margin-top:18rpx;padding:20rpx}.address-selector{display:flex;align-items:center;margin-top:18rpx;padding:24rpx;background:#fff;border-radius:14rpx;border:1rpx solid #edf0f2}.address-icon{font-size:42rpx;color:#1677ff;margin-right:18rpx}.address-content{flex:1;min-width:0}.address-title{font-size:29rpx;font-weight:700;color:#101828}.address-detail{margin-top:6rpx;color:#344054;font-size:27rpx;word-break:break-all}.address-contact{margin-top:8rpx;color:#667085;font-size:24rpx}.address-empty{color:#1677ff;font-size:29rpx}.address-empty view{margin-top:7rpx;color:#98a2b3;font-size:23rpx}.appointment-trigger{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx;padding:24rpx;background:#f7f8fa;border-radius:12rpx}.appointment-trigger-title{font-weight:600}.appointment-trigger-value{color:#667085;flex:1;text-align:right;margin-left:20rpx}.chevron{font-size:36rpx;color:#98a2b3;margin-left:12rpx}.submit-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:18rpx 28rpx;border-top:1rpx solid #eee;display:flex;align-items:center;justify-content:space-between;z-index:10}.submit-bar text{color:#e5484d;font-size:36rpx;font-weight:700}.submit-bar button{margin:0;width:300rpx}.appointment-modal{position:fixed;z-index:100;left:0;right:0;top:0;bottom:0}.appointment-mask{position:absolute;top:0;right:0;bottom:0;left:0;background:rgba(0,0,0,.48)}.appointment-sheet{position:absolute;left:0;right:0;bottom:0;height:78vh;background:#fff;border-radius:28rpx 28rpx 0 0;display:flex;flex-direction:column;overflow:hidden}.appointment-header{display:flex;justify-content:space-between;align-items:flex-start;padding:32rpx 36rpx 20rpx}.appointment-title{font-size:38rpx;font-weight:700;color:#101828}.appointment-subtitle{font-size:25rpx;color:#f5a623;margin-top:12rpx}.appointment-close{font-size:48rpx;line-height:42rpx;color:#c4c7cc}.appointment-body{display:flex;flex:1;min-height:0}.appointment-dates{width:39%;background:#f5f6f8;height:100%;box-sizing:border-box;padding:8rpx 0}.appointment-slots{width:61%;height:100%;box-sizing:border-box;padding:8rpx 28rpx 8rpx 34rpx}.date-option{padding:28rpx 20rpx;color:#667085;font-size:28rpx;line-height:1.35;text-align:center}.date-option.selected{background:#fff;color:#101828;font-weight:700}.slot-period{padding:18rpx 0 8rpx;color:#98a2b3;font-size:26rpx}.slot-option{padding:22rpx 0;border-bottom:1rpx solid #edf0f2;color:#344054;font-size:31rpx}.slot-option.selected{color:#1677ff;font-weight:700}.appointment-actions{display:flex;gap:20rpx;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #f0f2f5}.appointment-actions button{flex:1;margin:0;height:88rpx;line-height:88rpx;border-radius:44rpx;font-size:31rpx}.cancel-button{background:#fff;color:#1677ff;border:2rpx solid #1677ff}.confirm-button{background:#1677ff;color:#fff;border:2rpx solid #1677ff}
