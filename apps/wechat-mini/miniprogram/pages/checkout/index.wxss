.checkout-page{padding:16px 16px calc(84px + env(safe-area-inset-bottom))}.card{padding:14px 16px;margin-bottom:12px;border-radius:var(--radius-card)}.card-title{font-size:16px;font-weight:600;margin-bottom:4px}.address-selector{display:flex;align-items:center;gap:10px;min-height:60px;padding-bottom:14px}.address-icon{width:22px;height:22px;flex:none}.address-content{flex:1;min-width:0}.address-detail{font-size:15px;line-height:1.6;font-weight:500;word-break:break-all}.address-contact{margin-top:5px;font-size:12px;line-height:1.6;color:var(--color-text-secondary);word-break:break-word}.address-empty{font-size:15px;color:var(--color-primary)}.chevron{font-size:20px;color:var(--color-text-secondary);flex:none}.appointment-trigger{display:flex;align-items:center;gap:10px;min-height:48px;padding-top:4px;border-top:1px solid var(--color-border)}.field-label{font-size:13px;flex:none}.appointment-value{flex:1;min-width:0;text-align:right;font-size:12px;color:var(--color-text-secondary);line-height:1.6;word-break:break-word}.appointment-value.chosen{color:var(--color-text)}.field-error{font-size:12px;color:var(--color-danger);padding:4px 0 10px}.service-row{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--color-border);align-items:center}.cover{width:56px;height:56px;border-radius:8px;flex:none;background:var(--color-page)}.cover-fallback{display:flex;justify-content:center;align-items:center}.cover-fallback image{width:24px;height:24px}.service-copy{flex:1;min-width:0}.service-name{font-size:14px;font-weight:500;line-height:1.5;word-break:break-all;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.service-price{display:flex;align-items:baseline;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-top:7px}.unit-price{font-size:12px;color:var(--color-text-secondary);word-break:break-word}.subtotal{font-size:14px;font-weight:500;flex:none;white-space:nowrap;color:var(--color-price)}.demand-entry{display:flex;align-items:center;gap:8px;min-height:44px;padding-top:6px;font-size:13px}.demand-summary{flex:1;min-width:0;text-align:right;font-size:12px;color:var(--color-text-secondary)}.submit-bar{position:fixed;bottom:0;left:0;right:0;z-index:10;display:flex;align-items:center;gap:12px;box-sizing:border-box;padding:12px 16px calc(12px + env(safe-area-inset-bottom));background:var(--color-surface);border-top:1px solid var(--color-border)}.total{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0;font-size:12px;color:var(--color-text-secondary);white-space:nowrap}.total text{font-size:20px;font-weight:600;color:var(--color-price)}.submit-bar button,.appointment-actions button{height:44px;line-height:44px;background:var(--color-primary);color:var(--color-on-primary);padding:0;margin:0;border-radius:22px;font-size:14px}.submit-bar button{width:136px;flex:none}.submit-bar button[disabled]{background:var(--color-primary-disabled);color:var(--color-disabled-text)}.state{padding:32px 16px;text-align:center;font-size:14px;color:var(--color-text-secondary)}.state-actions{display:flex;justify-content:center;gap:12px;margin-top:16px}.state-actions button{margin:0;font-size:13px;color:var(--color-primary);background:var(--color-primary-soft)}.pending-tip{font-size:12px;color:var(--color-text-secondary);padding:4px 0}.appointment-modal{position:fixed;inset:0;z-index:100}.appointment-mask{position:absolute;inset:0;background:rgba(15,23,42,.4)}.appointment-sheet{position:absolute;bottom:0;left:0;right:0;height:62vh;max-height:75vh;background:var(--color-surface);border-radius:18px 18px 0 0;display:flex;flex-direction:column;overflow:hidden}.appointment-header{display:flex;justify-content:space-between;padding:18px 16px 14px;gap:8px}.appointment-title{font-size:17px;font-weight:600}.appointment-subtitle{font-size:12px;color:var(--color-text-secondary);margin-top:6px;line-height:1.6}.appointment-close{width:32px;height:32px;line-height:32px;padding:0;margin:0;background:transparent;color:var(--color-text-secondary);font-size:24px;flex:none}.appointment-close::after{border:0}.appointment-body{display:flex;flex:1;min-height:0}.appointment-dates{width:47%;height:100%;background:var(--color-page)}.appointment-slots{width:53%;height:100%;box-sizing:border-box;padding:0 12px}.date-option{padding:15px 8px;font-size:12px;line-height:1.6;color:var(--color-text-secondary);text-align:center}.slot-period{padding:12px 8px 6px;font-size:12px;color:var(--color-text-secondary)}.slot-option{padding:14px 8px;margin-bottom:4px;font-size:14px;border-radius:8px;white-space:nowrap}.selected{background:var(--color-primary-soft);color:var(--color-primary);font-weight:600}.appointment-actions{padding:12px 16px calc(12px + env(safe-area-inset-bottom));border-top:1px solid var(--color-border)}.appointment-actions button{width:100%}@media(max-width:350px){.submit-bar{gap:8px}.submit-bar button{width:120px}.total text{font-size:18px}}
