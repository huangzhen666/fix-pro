page {
  min-height: 100%;
  background: #f5f7fa;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 32rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.06);
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: #667085;
  font-size: 26rpx;
  line-height: 1.65;
}

.primary-button {
  background: #1677ff !important;
  color: #fff !important;
  border-radius: 14rpx;
}

/* Shared default profile avatar; no private media is required. */
.default-avatar{position:relative;width:100%;height:100%;border-radius:50%;overflow:hidden;background:#e4eaf2}
.avatar-head{position:absolute;width:32%;height:32%;left:34%;top:18%;border-radius:50%;background:#98a7bb}
.avatar-body{position:absolute;width:66%;height:52%;left:17%;top:57%;border-radius:50% 50% 0 0;background:#98a7bb}
