@import "styles/theme.wxss";
page{min-height:100%;background:var(--color-page);color:var(--color-text);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:15px;line-height:1.5}
.page{padding:var(--space-page);box-sizing:border-box}
.card{margin-bottom:12px;padding:16px;border-radius:var(--radius-card);background:var(--color-surface);box-shadow:none}
.section-title{margin-bottom:12px;font-size:17px;font-weight:600}
.muted{color:var(--color-text-secondary);font-size:13px;line-height:1.6}
button{font-weight:500}
button[type="primary"],.primary-button{background:var(--color-primary)!important;color:var(--color-on-primary)!important;border-radius:22px}
button[type="primary"][disabled],.primary-button[disabled]{background:var(--color-primary-disabled)!important;color:var(--color-disabled-text)!important}
button::after{border-color:var(--color-border)}
.default-avatar{position:relative;width:100%;height:100%;border-radius:50%;overflow:hidden;background:var(--color-primary-soft)}
.avatar-head{position:absolute;width:32%;height:32%;left:34%;top:18%;border-radius:50%;background:#9BAEC0}
.avatar-body{position:absolute;width:66%;height:52%;left:17%;top:57%;border-radius:50% 50% 0 0;background:#9BAEC0}
