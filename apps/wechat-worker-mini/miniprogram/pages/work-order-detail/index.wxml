<view class="page">
  <view wx:if="{{loading}}" class="state">正在加载工单详情…</view>
  <view wx:elif="{{error}}" class="state error">{{error}}<button size="mini" bindtap="load">重新加载</button></view>
  <block wx:elif="{{order}}">
    <view class="card order-card">
      <view class="order-head"><view><view class="eyebrow">工单详情</view><view class="work-order-no">{{order.workOrderNo}}</view></view><text class="status">{{order.statusText}}</text></view>
      <view class="order-no">关联订单：{{order.orderNo}}</view>
      <view class="schedule"><view class="schedule-label">预约上门时间</view><view class="schedule-date">{{order.appointmentDateText || '待确认日期'}}</view><view class="schedule-slot">{{order.appointmentSlotLabel || '待确认时间段'}}</view><view wx:if="{{order.acceptanceReminder}}" class="acceptance-alert {{order.acceptanceExpired ? 'acceptance-alert-expired' : ''}}">{{order.acceptanceReminder}}</view></view>
      <view class="address"><text class="address-label">服务地址</text><text class="address-value">{{order.serviceAddress || '暂未提供'}}</text></view>
    </view>

    <view class="card customer-card">
      <view class="section-title">客户信息</view>
      <view class="customer-row"><text class="field-label">联系人</text><text class="field-value">{{order.customerName || '暂未提供'}}</text></view>
      <view class="customer-row"><text class="field-label">联系电话</text><text class="field-value phone">{{order.customerMobile || '暂未提供'}}</text></view>
      <button wx:if="{{order.customerMobile}}" class="call-button" size="mini" bindtap="callCustomer">拨打客户电话</button>
    </view>

    <view class="card service-card">
      <view class="section-title">服务项目</view>
      <view wx:if="{{!order.items.length}}" class="muted">暂无服务项目明细</view>
      <view wx:for="{{order.items}}" wx:key="id" class="service-item">
        <view class="service-item-head"><text class="service-name">{{item.name}}</text><text class="service-quantity">× {{item.quantity}}{{item.unit}}</text></view>
        <view wx:if="{{item.customerNote}}" class="customer-note"><text class="note-label">客户补充信息</text><text class="note-content">{{item.customerNote}}</text></view>
        <scroll-view wx:if="{{item.customerMedia.length}}" scroll-x="true" class="customer-media-row">
          <view wx:for="{{item.customerMedia}}" wx:key="id" wx:for-item="media" class="customer-media">
            <image wx:if="{{media.mediaType === 'IMAGE' && media.localUrl}}" src="{{media.localUrl}}" mode="aspectFill" />
            <video wx:if="{{media.mediaType === 'VIDEO' && media.localUrl}}" src="{{media.localUrl}}" controls />
            <view wx:if="{{!media.localUrl}}" class="media-loading">加载中</view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view class="card actions">
      <button wx:if="{{order.status === 'PENDING_ACCEPT' && !order.acceptanceExpired}}" type="primary" data-command="ACCEPT" bindtap="command">接单</button>
      <button wx:if="{{order.status === 'PENDING_ACCEPT'}}" type="warn" data-command="REJECT" bindtap="command">拒绝接单</button>
      <button wx:if="{{order.status === 'PENDING_ARRIVAL'}}" type="primary" data-command="ARRIVE" bindtap="command">标记已到达</button>
      <button wx:if="{{order.status === 'PENDING_ACCEPT' || order.status === 'PENDING_ARRIVAL'}}" size="mini" bindtap="reschedule">与客户沟通后改期</button>
      <button wx:if="{{order.status === 'PENDING_ACCEPT' || order.status === 'PENDING_ARRIVAL'}}" size="mini" type="warn" bindtap="returnWorkOrder">退回调度</button>
      <button wx:if="{{order.status === 'ARRIVED'}}" type="primary" data-command="START" bindtap="command">开始服务</button>
    </view>

    <view wx:if="{{order.status === 'PENDING_ARRIVAL' || order.status === 'ARRIVED' || order.status === 'IN_SERVICE'}}" class="card">
      <view class="section-title">现场凭证</view>
      <view class="muted evidence-hint">已按客户选购数量生成照片位；每个服务单位都需要一张施工前和一张施工后照片。</view>
      <view wx:for="{{order.items}}" wx:for-item="service" wx:key="id" class="evidence-service">
        <view class="evidence-service-title">{{service.name}} × {{service.quantity}}{{service.unit}}</view>
        <view wx:for="{{service.evidencePairs}}" wx:for-item="pair" wx:key="unitNo" class="evidence-pair">
          <view class="evidence-pair-title">第 {{pair.unitNo}} 个{{service.unit}}</view>
          <view class="evidence-pair-actions">
            <button wx:if="{{!pair.before}}" size="mini" data-stage="BEFORE" data-work-order-item-id="{{service.id}}" data-unit-no="{{pair.unitNo}}" bindtap="chooseMedia">上传施工前</button>
            <text wx:else class="evidence-uploaded">施工前已上传</text>
            <button wx:if="{{!pair.after}}" size="mini" data-stage="AFTER" data-work-order-item-id="{{service.id}}" data-unit-no="{{pair.unitNo}}" bindtap="chooseMedia">上传施工后</button>
            <text wx:else class="evidence-uploaded">施工后已上传</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{order.status === 'IN_SERVICE'}}" class="card">
      <view class="section-title">提交完工</view>
      <textarea maxlength="1000" placeholder="请填写完工说明" value="{{summary}}" bindinput="updateSummary" />
      <button type="primary" loading="{{submitting}}" bindtap="submit">提交完工审核</button>
    </view>
  </block>
</view>
