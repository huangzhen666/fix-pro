.login-page { min-height: 100vh; box-sizing: border-box; padding: 180rpx 40rpx 80rpx; background: linear-gradient(180deg, #eaf3ff 0%, #f5f7fa 55%); }
.brand-mark { color: #1677ff; font-size: 64rpx; font-weight: 700; letter-spacing: 2rpx; }
.subtitle { margin-top: 12rpx; color: #667085; font-size: 28rpx; }
.login-card { margin-top: 64rpx; padding: 44rpx 36rpx; border-radius: 24rpx; }
.heading { color: #101828; font-size: 40rpx; font-weight: 700; }
.hint { margin: 16rpx 0 36rpx; color: #98a2b3; font-size: 24rpx; line-height: 1.5; }
.field { height: 92rpx; margin-top: 20rpx; padding: 0 24rpx; box-sizing: border-box; border: 1rpx solid #d0d5dd; border-radius: 12rpx; background: #fff; }
.error { margin-top: 20rpx; color: #d92d20; font-size: 24rpx; }
.primary-button { margin-top: 36rpx; border-radius: 46rpx; background: #1677ff; color: #fff; }
