.page { min-height: 100vh; padding: 24rpx; background: #f5f7fa; box-sizing: border-box; }
.card { margin-bottom: 24rpx; padding: 32rpx; background: #fff; border-radius: 20rpx; }
.hero { background: linear-gradient(135deg, #1677ff, #4096ff); color: #fff; }
.eyebrow { font-size: 20rpx; opacity: .75; letter-spacing: 2rpx; }
.title { margin: 18rpx 0 12rpx; font-size: 42rpx; font-weight: 600; }
.muted { color: #667085; font-size: 24rpx; }
.hero .muted { color: rgba(255,255,255,.82); }
.section-title { margin-bottom: 24rpx; font-size: 30rpx; font-weight: 600; }
.summary-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; }
.summary-item { text-align: center; }
.value { margin-bottom: 8rpx; color: #1677ff; font-size: 42rpx; font-weight: 600; }
