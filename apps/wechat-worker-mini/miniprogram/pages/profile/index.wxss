.page { min-height: 100vh; padding: 24rpx; background: #f5f7fa; box-sizing: border-box; }
.card { margin-bottom: 20rpx; padding: 28rpx; background: #fff; border-radius: 16rpx; }
.profile { display: flex; align-items: center; gap: 20rpx; }
.avatar { width: 88rpx; height: 88rpx; flex: 0 0 88rpx; border-radius: 50%; background: #e6f4ff; color: #1677ff; line-height: 88rpx; text-align: center; font-size: 36rpx; }
.avatar-text { display: flex; align-items: center; justify-content: center; }
.title { font-size: 32rpx; font-weight: 600; }
.muted { color: #667085; font-size: 24rpx; }
.action-list { padding: 0 28rpx; }
.action { display: flex; justify-content: space-between; align-items: center; min-height: 96rpx; border-bottom: 1rpx solid #f2f4f7; color: #344054; font-size: 28rpx; }
.action:last-child { border-bottom: 0; }
.action text { color: #98a2b3; font-size: 40rpx; }
.action.danger { color: #d92d20; }
