<view class="page">
  <view class="card profile">
    <image wx:if="{{avatarLocalUrl}}" class="avatar" src="{{avatarLocalUrl}}" mode="aspectFill" />
    <view wx:else class="avatar avatar-text">{{workerSurname}}</view>
    <view><view class="title">{{workerName || '加载中...'}}</view><view class="muted">师傅编号：{{workerNo}}</view><view class="muted">手机号：{{mobile}}</view></view>
  </view>
  <view class="card action-list">
    <view class="action" bindtap="onChangePassword">修改密码 <text>›</text></view>
    <view class="action danger" bindtap="onLogout">退出登录 <text>›</text></view>
  </view>
</view>
